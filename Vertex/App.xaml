<Application x:Class="Vertex.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vertex"
             StartupUri="/Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Vertex;component/Themes/DarkTheme.xaml"/>
                <ResourceDictionary Source="/Vertex;component/Themes/Typeface.xaml"/>
                <ResourceDictionary Source="/Vertex;component/Themes/ButtonStyle.xaml"/>
                <ResourceDictionary Source="/Vertex;component/Themes/TextStyle.xaml"/>
                <ResourceDictionary Source="/Vertex;component/Themes/Icons.xaml"/>
                <ResourceDictionary Source="/Vertex;component/Themes/ScroolBar.xaml"/>
                <ResourceDictionary Source="/Vertex;component/Themes/Calendar.xaml"/>
                <ResourceDictionary Source="/Vertex;component/Themes/DatePicker.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
