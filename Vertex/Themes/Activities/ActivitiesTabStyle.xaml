<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    
    <Style x:Key="ActivitiesTabTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ReminderTabTitle}">
    </Style>
    
    <Style x:Key="AddActivityButton" TargetType="{x:Type Button}" BasedOn="{StaticResource AddReminderButton}">
       
        <!--On Hover-->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TextBrush}"/>
            </Trigger>
        </Style.Triggers>
        
    </Style>
    
    <Style x:Key="ShowAllActivityButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource ReminderHistoryToggleButton}">
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                <Setter Property="Background" Value="{StaticResource TextBrush}"/>
            </DataTrigger>
        </Style.Triggers>
        
    </Style>
    
</ResourceDictionary>