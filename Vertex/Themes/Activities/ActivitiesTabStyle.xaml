<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Styles Present Here-->
    
    <!--
    Activities Tab Tittle
    Add Reminder Button
    Show All Activities ToggleButton
    Add New Activity Button
    Today's Activities ScrollViewer
    All Activities ScrollViewer
    Show All Activities Icon
    Add Activity Icon-->
    
    <!--Activities Tab Tittle-->
    <Style x:Key="ActivitiesTabTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
        
    </Style>
    
    <!--Show All Activities ToggleButton-->
    <Style x:Key="ShowAllActivitiesToggleButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BasicToggleButton}">
        <Setter Property="Width" Value="35"/>
        <Setter Property="Height" Value="35"/>
        
        <Style.Triggers>
            <!--On Hover-->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource LightBackgroundBrush}"/>
            </Trigger>
            <!--Binding-->
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                <Setter Property="Background" Value="{StaticResource LightBackgroundBrush}"/>
            </DataTrigger>
        </Style.Triggers>
        
    </Style>
    
    <!--Add New Activity Button-->
    <Style x:Key="AddNewActivityButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        <Setter Property="Width" Value="35"/>
        <Setter Property="Height" Value="35"/>
        
        <Style.Triggers>
            <!--On Hover-->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource LightBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
        
    </Style>
    
    <!--Today's Activities ScrollViewer-->
    <Style x:Key="ShowAllActivitiesIsOff" TargetType="{x:Type ScrollViewer}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="False">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                <Setter Property="Visibility" Value="Hidden"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <!--All Activities ScrollViewer-->
    <Style x:Key="ShowAllActivitiesIsOn" TargetType="{x:Type ScrollViewer}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="False">
                <Setter Property="Visibility" Value="Hidden"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <!--Show All Activities Icon-->
    <Style x:Key="ShowAllIconActivities" TargetType="{x:Type Path}" BasedOn="{StaticResource Icons}">
        <Setter Property="Data" Value="{StaticResource All}"/>
        
        <Style.Triggers>
            <!--On Hover-->
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=IsMouseOver}" Value="True">
                <Setter Property="Fill" Value="{StaticResource LightTextBrush}"/>
            </DataTrigger>
            <!--Binding-->
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Tag}" Value="True">
                <Setter Property="Fill" Value="{StaticResource LightTextBrush}"/>
            </DataTrigger>
        </Style.Triggers>
        
    </Style>
    
    <!--Add New Activity icon-->
    <Style x:Key="AddNewActivityIcon" TargetType="{x:Type Path}" BasedOn="{StaticResource Icons}">
        <Setter Property="Data" Value="{StaticResource Add}"/>
        <Style.Triggers>
            <!--On Hover-->
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}" Value="True">
                <Setter Property="Fill" Value="{StaticResource LightTextBrush}"/>
            </DataTrigger>
        </Style.Triggers>
        
    </Style>
</ResourceDictionary>