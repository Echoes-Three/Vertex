<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Styles Present Here-->
    
    <!--
    Activities Tab Tittle
    Add Reminder Button
    Show Remaining Activities ToggleButton
    Add New Activity Button
    Today's Activities ScrollViewer
    Remaining Activities ScrollViewer
    Show All Activities Icon
    Add Activity Icon-->
    
    <!--Activities Tab Tittle-->
    <Style x:Key="ActivitiesTabTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource DmSerif}"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="FontSize" Value="35"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush-Gray-200}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
   
</ResourceDictionary>