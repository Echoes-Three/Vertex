<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Styles Present Here-->
    
    <!--
    Activity Title Input
    Activity Title Input Placeholder
    Activity Content Input
    Activity Content Input Placeholder
    Reticle TL
    Reticle TR
    Reticle BL
    Reticle BR
    Color Cover
    Color
    Duration Picker
    Duration Picker Icons
    Weekday Toggle Button
    Duration Picker
    Title / Content Limit Indicator
    Save Button Hover Animation Color
    Save Button Text Element On Hover
    Warning Hover Area
    Warning Body
    -->
    
    <!--Activity Title Input-->
    <Style x:Key="ActivityTitleInput" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush-Gray-200}"/>
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
        <Setter Property="AcceptsReturn" Value="False"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush-Gray-200}"/>
    </Style>
    
    <!--Activity Title Input Placeholder-->
    <Style x:Key="ActivityTitleInputPlaceholder" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource Brush-Gray-300}"/>
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
        <Setter Property="Visibility" Value="Hidden"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, ElementName=TitleInput}" Value="">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
        
    </Style>
    
    
    <!--Activity Content Input-->
    <Style x:Key="ActivityContentInput" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush-Gray-200}"/>
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush-Gray-100}"/>
    </Style>
    
    <!--Activity Content Input Placeholder-->
    <Style x:Key="ActivityContentInputPlaceholder" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource Brush-Gray-300}"/>
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
        <Setter Property="Visibility" Value="Hidden"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, ElementName=ContentInput}" Value="">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
        
    </Style>
    
    
    <!--Reticle TL-->
    <Style x:Key="ReticleTL" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush-Gray-600}"/>
        <Setter Property="BorderThickness" Value="0,0,10,10"/>
        <Setter Property="Margin" Value="25,25,0,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding ElementName=ColorPicker, Path=IsMouseOver}" Value="True">
                <Setter Property="Margin" Value="5,5,0,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <!--Reticle TR-->
    <Style x:Key="ReticleTR" TargetType="{x:Type Border}" BasedOn="{StaticResource ReticleTL}">
        <Setter Property="BorderThickness" Value="10,0,0,10"/>
        <Setter Property="Margin" Value="0,25,25,0"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding ElementName=ColorPicker, Path=IsMouseOver}" Value="True">
                <Setter Property="Margin" Value="0,5,5,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <!--Reticle BL-->
    <Style x:Key="ReticleBL" TargetType="{x:Type Border}" BasedOn="{StaticResource ReticleTL}">
        <Setter Property="BorderThickness" Value="00,10,10,0"/>
        <Setter Property="Margin" Value="25,0,0,25"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding ElementName=ColorPicker, Path=IsMouseOver}" Value="True">
                <Setter Property="Margin" Value="5,0,0,5"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <!--Reticle BR-->
    <Style x:Key="ReticleBR" TargetType="{x:Type Border}" BasedOn="{StaticResource ReticleTL}">
        <Setter Property="BorderThickness" Value="10,10,0,0"/>
        <Setter Property="Margin" Value="0,0,25,25"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding ElementName=ColorPicker, Path=IsMouseOver}" Value="True">
                <Setter Property="Margin" Value="0,0,5,5"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
     <!--Color Cover-->
    <Style x:Key="ColorCover" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Visibility" Value="Visible"/>
        <Setter Property="Background" Value="{StaticResource Brush-Gray-500}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding ElementName=ColorPicker, Path=IsMouseOver}" Value="True">
                <Setter Property="Visibility" Value="Hidden"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
     <!--Color-->
    <Style x:Key="Color" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="80"/>
        <Setter Property="Height" Value="80"/>
        <Setter Property="Visibility" Value="Hidden"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding ElementName=ColorPicker, Path=IsMouseOver}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    
    <!--Duration Picker-->
    <Style x:Key="DurationPickerDigits" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="50"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush-Gray-400}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        
    </Style>
    
    <!--Duration Picker Icons-->
    <Style x:Key="DurationPickerButtonIcon" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Thin"/>
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush-Gray-500}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        
    </Style>
    
    <!--Weekday Toggle Button-->
    <Style x:Key="WeekDayToggleButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BasicToggleButton}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="{StaticResource Brush-Gray-400}"/>
        <Setter Property="Background" Value="{StaticResource Brush-Gray-700}"/>
        
        <!--Removes Default Style-->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Background" Background="{TemplateBinding Background}" CornerRadius="5">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Button.Click">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation
                                        Storyboard.TargetName="Background"
                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                        To="{StaticResource PersianBlue}"
                                        Duration="0:0:0.1"
                                        AutoReverse="True"
                                        FillBehavior="Stop"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        
        <Style.Triggers>
            
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush-Gray-600}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush-Gray-300}"/>
            </Trigger>
            
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{StaticResource VividRoyalBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource Brush-Gray-200}"/>
                </MultiTrigger.Setters>
            </MultiTrigger>
            
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{StaticResource PersianBlueBrush}"/>
                </MultiTrigger.Setters>
            </MultiTrigger>
            
        </Style.Triggers>
        
    </Style>
    <!--Title / Content Limit Indicator-->
    <Style x:Key="ActivityLimitIndicator" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource Brush-Gray-500}"/>
        
        <Style.Triggers>
            <Trigger Property="Tag" Value="Content">
                <Setter Property="VerticalAlignment" Value="Bottom"/>
            </Trigger>
        </Style.Triggers>
        
    </Style>
    
    <!--Save Button Hover Animation Color-->
    <Style x:Key="SaveButtonHoverAnimationColor" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource LipstickRedBrush}"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding ElementName=HoverAnimationHolder, Path=Tag}" Value="True">
                <Setter Property="Background" Value="{StaticResource ChartreuseBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <!--Save Button Text Element On Hover-->
    <Style x:Key="SaveButtonTextOnHover" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ActivityTitle}">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource Brush-Gray-500}"/>
        
        <Style.Triggers>
            
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding ElementName=HoverAnimationHolder, Path=Tag}" Value="True"/>
                    <Condition Binding="{Binding ElementName=HoverAnimationHolder, Path=IsMouseOver}" Value="True"></Condition>
                </MultiDataTrigger.Conditions>
                
                <MultiDataTrigger.Setters>
                    <Setter Property="Foreground" Value="{StaticResource Brush-Gray-700}"/>
                </MultiDataTrigger.Setters>
            </MultiDataTrigger>
            
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding ElementName=HoverAnimationHolder, Path=Tag}" Value="False"/>
                    <Condition Binding="{Binding ElementName=HoverAnimationHolder, Path=IsMouseOver}" Value="True"></Condition>
                </MultiDataTrigger.Conditions>
                
                <MultiDataTrigger.Setters>
                    <Setter Property="Foreground" Value="{StaticResource Brush-Gray-200}"/>
                </MultiDataTrigger.Setters>
            </MultiDataTrigger>
            
        </Style.Triggers>
    </Style>
    
    
    <!--Warning Hover Area-->
    <Style x:Key="WarningHover" TargetType="{x:Type Grid}">
        <Setter Property="Visibility" Value="Hidden"/>
        
        <Style.Triggers>
            
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding ElementName=HoverAnimationHolder, Path=Tag}" Value="False"/>
                    <Condition Binding="{Binding ElementName=HoverAnimationHolder, Path=IsMouseOver}" Value="True"/>
                </MultiDataTrigger.Conditions>
                
                <MultiDataTrigger.Setters>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger.Setters>
            </MultiDataTrigger>
            
        </Style.Triggers>
    </Style>
    
    <!--Warning Body-->
    <Style x:Key="WarningBody" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush-Gray-200}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>
</ResourceDictionary>