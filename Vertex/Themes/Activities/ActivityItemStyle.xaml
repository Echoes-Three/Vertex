<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Styles Present Here-->
    
    <!--
    Activity Title
    Removes TextBox Style
    Activity Content
    Expand Content Toggle
    Edit Activity Button Hover
    Edit Activity Button
    Delete Activity Button Hover
    Delete Activity Button
    RowDefinition Expand
    Show Activity Action Buttons
    -->
    
    <!--Activity Title-->
    <Style x:Key="ActivityTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{StaticResource Brush-Gray-200}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="Margin" Value="10,5,0,0"/>
        
    </Style>
    
    <!--Removes TextBox Style-->
    <Style x:Key="NoStyleTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="AllowDrop" Value="true"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBoxBase}">
                    <Border 
                        Name="Border"
                        CornerRadius="0" 
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0" >
                        <ScrollViewer Margin="0" x:Name="PART_ContentHost"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Foreground" Value="Transparent"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--Activity Content-->
    <Style x:Key="ActivityContent" TargetType="{x:Type TextBox}" BasedOn="{StaticResource NoStyleTextBox}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="TextAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush-Gray-200}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="Margin" Value="5"/>
    </Style>
    
    <!--Expand Content Toggle-->
    <Style x:Key="ShowContentToggle" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BasicToggleButton}">
        
        <!--Removes Default Style-->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Background" Background="{TemplateBinding Background}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Button.Click">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation
                                        Storyboard.TargetName="Background"
                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                        To="Transparent"
                                        Duration="0:0:0.1"
                                        AutoReverse="True"
                                        FillBehavior="Stop"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        
    </Style>
    
    <!--Edit Activity Button Hover-->
    <Style x:Key="EditActivityButtonHover" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Brush-Gray-600}"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding ElementName=EditActivityButton, Path=IsMouseOver}" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush-Gray-500}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <!--Edit Activity Button-->
    <Style x:Key="EditActivityButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource Brush-Gray-400}"/>
        <Setter Property="Width" Value="30"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding ElementName=EditActivityButton, Path=IsMouseOver}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush-Gray-200}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <!--Delete Activity Button Hover-->
    <Style x:Key="DeleteActivityButtonHover" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Brush-Gray-600}"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding ElementName=DeleteActivityButton, Path=IsMouseOver}" Value="True">
                <Setter Property="Background" Value="{StaticResource LipstickRedBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <!--Delete Activity Button-->
    <Style x:Key="DeleteActivityButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource Brush-Gray-400}"/>
        <Setter Property="Width" Value="30"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding ElementName=DeleteActivityButton, Path=IsMouseOver}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush-Gray-700}"/>
            </DataTrigger>
        </Style.Triggers>
        
    </Style>
    
    <!--RowDefinition Expand-->
    <Style x:Key="ContentExpand" TargetType="{x:Type RowDefinition}">
        <Setter Property="Height" Value="0"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, ElementName=ShowContent}" Value="True">
                <Setter Property="Height" Value="110"/>
            </DataTrigger>
        </Style.Triggers>
        
    </Style>
    
    <!--Show Activity Action Buttons-->
    <Style x:Key="ShowActivityActionButtons" TargetType="{x:Type Grid}">
        <Setter Property="Visibility" Value="Hidden"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding ElementName=MainGrid, Path=IsMouseOver}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
</ResourceDictionary>