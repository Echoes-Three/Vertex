<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    
    <Style x:Key="ActivitiesMessage" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource RemindersDonePlaceholderMessage}">
    </Style>
    
    <Style x:Key="ActivityTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ActivitiesTabTitle}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    
    <Style x:Key="ActivityContent" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ReminderContent}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    
    <Style x:Key="EditActivityButton" TargetType="{x:Type Button}" BasedOn="{StaticResource EditReminderButton}">
        
    </Style>
    
    <Style x:Key="DeleteActivityButton" TargetType="{x:Type Button}" BasedOn="{StaticResource DeleteReminderButton}">
        
    </Style>
    
    <Style x:Key="MarkActivityAsDoneButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MarkReminderAsDoneButton}">
        
        
    </Style>
    
    <!--Current Day Activities ScrollViewer-->
    <Style x:Key="ShowAllActivitiesIsOff" TargetType="{x:Type ScrollViewer}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="False">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                <Setter Property="Visibility" Value="Hidden"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <!--All Activities ScrollViewer-->
    <Style x:Key="ShowAllActivitiesIsOn" TargetType="{x:Type ScrollViewer}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="False">
                <Setter Property="Visibility" Value="Hidden"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>