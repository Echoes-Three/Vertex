<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Styles Present Here-->
    
    <!--
    Activity Title
    Activity Content
    Delete Activity Button
    Edit Activity Button
    Delete Activity Icon
    Edit Activity Icon
/   Tooltip Activity Hover-->
    
    <!--Activity Title-->
    <Style x:Key="ActivityTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource LightTextBrush}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="Margin" Value="10,5,5,5"/>
        
    </Style>
    
    <!--Activity Content-->
    <Style x:Key="ActivityContent" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="TextAlignment" Value="Left"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource LightTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,8,0,8"/>
    </Style>
    
    <!--Edit Activity Button-->
    <Style x:Key="EditActivityButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        
        <!--On Hover-->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource LightBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!--Delete Activity Button-->
    <Style x:Key="DeleteActivityButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        
        <!--On Hover-->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource LipstickRedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!--Delete Activity Icon-->
    <Style x:Key="DeleteActivityIcon" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="Thin"/>
        <Setter Property="Foreground" Value="{StaticResource LightTextBrush}"/>
    </Style>
    
    <!--Edit Activity Icon-->
    <Style x:Key="EditActivityIcon" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DeleteActivityIcon}">
    </Style>
    
    <!--Tooltip Activity Hover-->
    <Style x:Key="ActivityHoverToolTip" TargetType="{x:Type TextBlock}">
        <Setter Property="Text" Value="+"/>
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="Foreground" Value="{StaticResource LightTextBrush}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Thin"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>