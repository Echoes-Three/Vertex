<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Styles Present Here-->
    
    <!--
    Title Limit Counter
    Content Limit Counter
    Activity Title Input
    Activity Title Input Placeholder
    Activity Content Input
    Activity Content Input Placeholder
    Weekday Toggle Button
    Duration Picker
    Cancel Activity Entry Button
    Save Activity Entry Button
    Color Picker Border
    Color Picker Hover Animation
    Title Limit Indicator
    Content Limit Indicator
    Hover Animation Corners
    Duration / Color Header
    Tooltip Body
    Tooltip Header-->
    
    <!--Activity Content Input-->
    <Style x:Key="ActivityContentInput" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush-Gray-100}"/>
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush-Gray-100}"/>
    </Style>
    
    <!--Activity Content Input Placeholder-->
    <Style x:Key="ActivityContentInputPlaceholder" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource Brush-Gray-100}"/>
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Visibility" Value="Hidden"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, ElementName=ContentInput}" Value="">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
        
    </Style>
    
    <!--Activity Title Input-->
    <Style x:Key="ActivityTitleInput" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush-Gray-100}"/>
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
        <Setter Property="AcceptsReturn" Value="False"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush-Gray-100}"/>
    </Style>
    
    <!--Activity Title Input Placeholder-->
    <Style x:Key="ActivityTitleInputPlaceholder" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource Brush-Gray-100}"/>
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
        <Setter Property="Visibility" Value="Hidden"/>
      
        <Setter Property="MinHeight" Value="0"></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, ElementName=TitleInput}" Value="">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
        
    </Style>
    
    <!--Duration Picker-->
    <Style x:Key="DurationPicker" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush-Gray-100}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="65"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        
    </Style>
    
    <!--Weekday Toggle Button-->
    <Style x:Key="WeekDayToggleButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BasicToggleButton}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="12"/>
        
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush-Gray-300}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush-Gray-100}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{StaticResource Brush-Gray-400}"/>
                    <Setter Property="Foreground" Value="{StaticResource Brush-Gray-100}"/>
                </MultiTrigger.Setters>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{StaticResource Brush-Gray-300}"/>
                    <Setter Property="Foreground" Value="{StaticResource Brush-Gray-500}"/>
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
    
    <!--Cancel Activity Entry Button-->
    <Style x:Key="CancelActivityEntry" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        <Setter Property="Background" Value="{StaticResource Brush-Gray-400}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        
        <Style.Triggers>
            <!--On Hover-->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush-Gray-300}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush-Gray-500}"/>
            </Trigger>
        </Style.Triggers>
        
    </Style>
    
    <!--Save Activity Entry Button-->
    <Style x:Key="SaveActivityEntry" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        <Setter Property="Background" Value="{StaticResource Brush-Gray-400}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        
        <Style.Triggers>
            <!--On Hover-->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush-Gray-300}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush-Gray-500}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!--Title Limit Indicator-->
    <Style x:Key="ActivityTitleLimitIndicator" TargetType="{x:Type Border}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="0,0,5,5"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Width" Value="15"/>
        <Setter Property="CornerRadius" Value="3"/>
        
    </Style>
    
    <!--Content Limit Indicator-->
    <Style x:Key="ActivityContentLimitIndicator" TargetType="{x:Type Border}" BasedOn="{StaticResource ActivityTitleLimitIndicator}">
    </Style>
    
    <!--Color Picker Border-->
    <Style x:Key="ColorPickerBorder" TargetType="{x:Type Border}">
        <Setter Property="Cursor" Value="ScrollNS"/>
        <Setter Property="Margin" Value="24,22"/>
        
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Margin" Value="0,0,0,0"/> 
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!--Color Picker Hover Animation-->
    <Style x:Key="ColorPickerHoverAnimation" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="{StaticResource Brush-Gray-300}"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="Width" Value="25"/>
    </Style>
    
    <!--Hover Animation Corners-->
    <Style x:Key="TopLeft" TargetType="{x:Type Border}" BasedOn="{StaticResource ColorPickerHoverAnimation}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="2,2,0,0"/>
        <Setter Property="Background" Value="{StaticResource Brush-Gray-300}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=ColorPickerSquare}" Value="True">
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Background" Value="Transparent"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="TopRight" TargetType="{x:Type Border}" BasedOn="{StaticResource ColorPickerHoverAnimation}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0,2,2,0"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=ColorPickerSquare}" Value="True">
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="BottomLeft" TargetType="{x:Type Border}" BasedOn="{StaticResource ColorPickerHoverAnimation}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="2,0,0,2"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=ColorPickerSquare}" Value="True">
                <Setter Property="VerticalAlignment" Value="Bottom"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="BottomRight" TargetType="{x:Type Border}" BasedOn="{StaticResource ColorPickerHoverAnimation}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0,0,2,2"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=ColorPickerSquare}" Value="True">
                <Setter Property="VerticalAlignment" Value="Bottom"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="ColorNumberBackground" TargetType="{x:Type Border}" BasedOn="{StaticResource ColorPickerHoverAnimation}">
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Background" Value="{StaticResource Brush-Gray-400}"/>
        <Setter Property="CornerRadius" Value="3,0,0,0"></Setter>
        <Setter Property="Visibility" Value="Hidden"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=ColorPickerSquare}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="ColorNumber" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush-Gray-100}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    
    <!--Duration / Color Header-->
    <Style x:Key="Header" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush-Gray-100}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Regular"/>
    </Style>
    
    <!--Tooltip Body-->
    <Style x:Key="ActivityTooltipBody" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush-Gray-100}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>
    
    <!--Tooltip Header-->
    <Style x:Key="ActivityTooltipHeader" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush-Gray-100}"/>
        <Setter Property="FontSize" Value="25"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="left"/>
    </Style>
</ResourceDictionary>