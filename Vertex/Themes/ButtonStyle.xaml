<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Basic Style-->
    <Style x:Key="BasicButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource ElementBackground}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        
        <!--Removes Default Style-->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        
        <!--On Hover-->
        <Style.Triggers>
            
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ELementHighlight}"/>
            </Trigger>
            
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource WindowBackground}"/>
            </Trigger>
            
        </Style.Triggers>
        
    </Style>
    
    <!--Minimize Button-->
    <Style x:Key="MinimizeButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        
        <!--On Hover-->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ELementHighlight}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!--Close Button-->
    <Style x:Key="CloseButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        
        <!--On Hover-->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="TabButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <!--On Hover-->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ELementHighlight}"/>
            </Trigger>
        </Style.Triggers>
        
    </Style>
    
    <Style x:Key="ActionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        <Setter Property="Foreground" Value="{StaticResource ELementHighlight}"/>
        <Setter Property="Background" Value="{StaticResource Element}"></Setter>
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontSize" Value="15"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    
</ResourceDictionary>