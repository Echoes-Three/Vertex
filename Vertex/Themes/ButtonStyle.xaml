<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Basic Button Style-->
    <Style x:Key="BasicButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        
        <!--Removes Default Style-->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        
        <!--On Hover-->
        <Style.Triggers>
            
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TextBrush}"/>
            </Trigger>
            
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource WindowBackgroundBrush}"/>
            </Trigger>
            
        </Style.Triggers>
        
    </Style>
    
    <!--Minimize Button-->
    <Style x:Key="MinimizeButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        
        <!--On Hover-->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TextBrush}"/>
            </Trigger>
        </Style.Triggers>
        
    </Style>
    
    <!--Close Button-->
    <Style x:Key="CloseButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        
        <!--On Hover-->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TextBrush}"/>
            </Trigger>
        </Style.Triggers>
        
    </Style>
    
    <Style x:Key="AddReminderButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        <Setter Property="Width" Value="35"/>
        <Setter Property="Height" Value="35"/>
        <!--On Hover-->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="HistoryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource AddReminderButton}"></Style>
    <Style x:Key="SortButton" TargetType="{x:Type Button}" BasedOn="{StaticResource AddReminderButton}"></Style>
    
    <Style x:Key="DeleteReminderButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontSize" Value="15"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="RemindMeButton" TargetType="{x:Type Button}" BasedOn="{StaticResource DeleteReminderButton}"></Style>
    <Style x:Key="EditReminderButton" TargetType="{x:Type Button}" BasedOn="{StaticResource DeleteReminderButton}"></Style>
    <Style x:Key="MarkReminderAsDoneButton" TargetType="{x:Type Button}" BasedOn="{StaticResource DeleteReminderButton}"></Style>
    <Style x:Key="CancelReminderEntry" TargetType="{x:Type Button}" BasedOn="{StaticResource DeleteReminderButton}"></Style>
    <Style x:Key="SaveReminderEntry" TargetType="{x:Type Button}" BasedOn="{StaticResource DeleteReminderButton}"></Style>
    
</ResourceDictionary>