<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    
    <Style x:Key="ConsistencyTabTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ReminderTabTitle}">
    </Style>
    
    <Style x:Key="Percentage" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="FontSize" Value="10"/>
        
        <Style.Triggers>
            <Trigger Property="Tag" Value="Percentage">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Trigger>
            
            <Trigger Property="Tag" Value="WeekDays">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Trigger>
            
        </Style.Triggers>
    </Style>
    
    <Style x:Key="WeekDays" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Percentage}">
    </Style>
</ResourceDictionary>