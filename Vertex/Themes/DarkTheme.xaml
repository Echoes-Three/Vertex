<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Color x:Key="WindowBackgroundColor" >#0E0E0E</Color>
    <Color x:Key="ElementBackgroundColor" >#1F1F1F</Color>
    <Color x:Key="ButtonBackgroundColor" >#3D3D3D</Color>
    <Color x:Key="TextColor" >#AAAAAA</Color>
    <Color x:Key="AccentColor1" >#556483</Color>
    
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="ElementBackgroundBrush" Color="{DynamicResource ElementBackgroundColor}"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{DynamicResource ButtonBackgroundColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
    <SolidColorBrush x:Key="AccentColor1Brush" Color="{DynamicResource AccentColor1}"/>
    
</ResourceDictionary>