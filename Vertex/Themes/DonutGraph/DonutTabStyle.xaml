<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Styles Present Here-->
    
    <!--
    Donut Graph Tab Title
    Middle Clock Styles
    Clock Face
    Tooltip Body
    Tooltip Header-->
    
    <!--Donut Graph TabTitle-->
    <Style x:Key="DonutGraphTabTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ReminderTabTitle}">
    </Style>
    
    <!--Middle Clock Styles-->
    <Style x:Key="Hour" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="150"/>
        <Setter Property="Foreground" Value="{DynamicResource LightTextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    
    <Style x:Key="Minute" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Hour}">
        <Setter Property="FontSize" Value="50"/>
    </Style>
    
    <Style x:Key="Meridiem" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Minute}">
    </Style>
    
    <Style x:Key="UpperInfo" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Hour}">
        <Setter Property="FontSize" Value="20"/>
    </Style>
    
    <Style x:Key="TitleInfo" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Hour}">
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    
    <Style x:Key="LowerInfo" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource UpperInfo}">
    </Style>
    
    <!--Clock Face-->
    <Style x:Key="MainClockFace" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Hour}">
        <Setter Property="FontSize" Value="25"/>
    </Style>
    
    <!--Tooltip Body-->
    <Style x:Key="OrbitersTooltipBody" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="Foreground" Value="{StaticResource LightTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="15"/>
        <Setter Property="MinHeight" Value="50"></Setter>
    </Style>
    
    <!--Tooltip Header-->
    <Style x:Key="OrbitersTooltipHeader" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="Foreground" Value="{StaticResource LightTextBrush}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>