<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Styles Present Here-->
    
    <!--
    Donut Graph Tab Title
    Middle Clock Styles
    Clock Face
    Tooltip Content
    Tooltip Header
    -->
    
    <!--Middle Clock Styles-->
    <Style x:Key="ClockHour" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="50"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush-Gray-100}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    
    <Style x:Key="TitleInfo" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ClockHour}">
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="FontSize" Value="22"/>
    </Style>
    
    <Style x:Key="ClockDayOfTheWeek" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ClockHour}">
        <Setter Property="FontSize" Value="15"/>
    </Style>
    
    <Style x:Key="ClockDate" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ClockDayOfTheWeek}">
    </Style>
    
    <!--Clock Face-->
    <Style x:Key="MainClockFace" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ClockHour}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Regular"/>
    </Style>
    
</ResourceDictionary>