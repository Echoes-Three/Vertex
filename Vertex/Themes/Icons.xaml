    <!--Base Path Style-->
    <Style x:Key="Icons" TargetType="{x:Type Path}">
        <Setter Property="Fill" Value="{StaticResource DarkTextBrush}"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Stretch" Value="Uniform"/>
        
    </Style>
    
    
    <Style x:Key="ArrowDownIcon" TargetType="{x:Type Path}" BasedOn="{StaticResource Icons}">
        <Setter Property="Data" Value="{StaticResource ArrowDown}"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="Margin" Value="0,35,0,0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        
        <Style.Triggers>
            <!--On Hover-->
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=RemindDay}" Value="True">
                <Setter Property="Fill" Value="{StaticResource DarkBackgroundBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    
    <!--Calendar-->
    <Style x:Key="CalendarIcon" TargetType="{x:Type Path}" BasedOn="{StaticResource Icons}">
        <Setter Property="Data" Value="{StaticResource Calendar}"/>
        
        <Style.Triggers>
            <!--On Hover-->
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=IsMouseOver}" Value="True">
                <Setter Property="Fill" Value="{StaticResource DarkBackgroundBrush}"/>
            </DataTrigger>
        </Style.Triggers>
        
    </Style>
    
    <Style x:Key="ArrowUpIcon" TargetType="{x:Type Path}" BasedOn="{StaticResource Icons}">
        <Setter Property="Data" Value="{StaticResource ArrowUp}"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,35"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        
        <!--On Hover-->
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=RemindDay}" Value="True">
                <Setter Property="Fill" Value="{StaticResource DarkBackgroundBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="SwapIcon" TargetType="{x:Type Path}" BasedOn="{StaticResource Icons}">
        <Setter Property="Data" Value="{StaticResource Swap}"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Width" Value="15"/>
        
        <!--On Hover-->
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=SwapActivity}" Value="True">
                <Setter Property="Fill" Value="{StaticResource DarkBackgroundBrush}"/>
            </DataTrigger>
        </Style.Triggers>
        
    </Style>
    
    <Style x:Key="EmptyCheckBoxIcon" TargetType="{x:Type Path}" BasedOn="{StaticResource Icons}">
        <Setter Property="Data" Value="{StaticResource EmptyCheckBox}"/>
        
        <!--On Hover-->
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=IsMouseOver}" Value="True">
                <Setter Property="Fill" Value="{StaticResource DarkBackgroundBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Tag}" Value="True">
                <Setter Property="Fill" Value="{StaticResource DarkBackgroundBrush}"/>
            </DataTrigger>
        </Style.Triggers>
        
    </Style>
    
    <Style x:Key="SelectedCheckBoxIcon" TargetType="{x:Type Path}" BasedOn="{StaticResource Icons}">
        <Setter Property="Data" Value="{StaticResource SelectedCheckBox}"/>
        
        <!--On Hover-->
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=IsMouseOver}" Value="True">
                <Setter Property="Fill" Value="{StaticResource DarkBackgroundBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Tag}" Value="True">
                <Setter Property="Fill" Value="{StaticResource DarkBackgroundBrush}"/>
            </DataTrigger>
        </Style.Triggers>
        
    </Style>
    
</ResourceDictionary>