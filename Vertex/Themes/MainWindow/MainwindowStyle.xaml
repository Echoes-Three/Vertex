<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Styles Present Here-->
    
    <!--
    Toggle Buttons
    Activity Toggle Background
    Reminder Toggle Background
    Form Toggle Background
    
    -->
    
    <!--Toggle Buttons-->
    <Style x:Key="ToggleButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BasicToggleButton}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="ExtraLight"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="Foreground" Value="{StaticResource Brush-Gray-200}"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        
        <Style.Triggers>
            
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush-Gray-700}"/>
            </Trigger>
            
        </Style.Triggers>
        
    </Style>
    
    <!--Activity Toggle Background-->
    <Style x:Key="ActivityToggleBackground" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Brush-Gray-700}"/>
        <Setter Property="CornerRadius" Value="5"/>
        
        <Style.Triggers>
            
            <DataTrigger Binding="{Binding ElementName=ActivityToggle, Path=IsMouseOver}" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush-Gray-600}"/>
            </DataTrigger>
            
            <DataTrigger Binding="{Binding ElementName=ActivityToggle, Path=IsChecked}" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush-Gray-200}"/>
            </DataTrigger>
            
         </Style.Triggers>   
        
    </Style>
    
    <!--Reminder Toggle Background-->
    <Style x:Key="ReminderToggleBackground" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Brush-Gray-700}"/>
        <Setter Property="CornerRadius" Value="5"/>
        
        <Style.Triggers>
            
            <DataTrigger Binding="{Binding ElementName=ReminderToggle, Path=IsMouseOver}" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush-Gray-600}"/>
            </DataTrigger>
            
            <DataTrigger Binding="{Binding ElementName=ReminderToggle, Path=IsChecked}" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush-Gray-200}"/>
            </DataTrigger>
            
        </Style.Triggers>   
        
    </Style>
    
    <!--Form Toggle Background-->
    <Style x:Key="FormToggleBackground" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Brush-Gray-700}"/>
        <Setter Property="CornerRadius" Value="5"/>
        
        <Style.Triggers>
            
            <DataTrigger Binding="{Binding ElementName=FormToggle, Path=IsMouseOver}" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush-Gray-600}"/>
            </DataTrigger>
            
            <DataTrigger Binding="{Binding ElementName=FormToggle, Path=IsChecked}" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush-Gray-200}"/>
            </DataTrigger>
            
        </Style.Triggers>   
        
    </Style>
    
    
    <!--Duration Setter Icons-->
    <Style x:Key="DurationSetterButtonIcon" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Thin"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush-Gray-500}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    
    <!--Duration Setter Digits-->
    <Style x:Key="DurationSetterDigits" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="35"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush-Gray-400}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    
</ResourceDictionary>