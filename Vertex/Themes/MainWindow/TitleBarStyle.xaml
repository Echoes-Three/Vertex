<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Styles Present Here-->
    
    <!--
    Minimize Button
    Close Button-->
    
    
    <!--Minimize Button-->
    <Style x:Key="MinimizeButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        
        <!--On Hover-->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TextBrush}"/>
            </Trigger>
        </Style.Triggers>
        
    </Style>
    
    <!--Close Button-->
    <Style x:Key="CloseButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        
        <!--On Hover-->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TextBrush}"/>
            </Trigger>
        </Style.Triggers>
        
    </Style>
</ResourceDictionary>