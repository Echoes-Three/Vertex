<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Styles Present Here-->
    
    <!--
    Reminder Date Label
    Restore Reminder Button-->
    
    <!--Reminder Date Label-->
    <Style x:Key="ReminderDateLabel" TargetType="{x:Type TextBlock}" >
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        
    </Style>
    
    <!--Restore Reminder Button-->
    <Style x:Key="RestoreReminder" TargetType="{x:Type Button}" BasedOn="{StaticResource DeleteReminderButton}">
    </Style>
    
</ResourceDictionary>