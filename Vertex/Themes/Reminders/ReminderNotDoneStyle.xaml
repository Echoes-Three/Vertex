<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Styles Present Here-->
    
    <!--
    Reminder Content
    Delete Reminder Button
    Edit Reminder Button
    Mark Reminder As Done Button
    Delete Reminder Icon
    Edit Reminder Icon-->
    
    <!--Reminder Content-->
    <Style x:Key="ReminderContent" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="MinHeight" Value="80"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    
    <!--Delete Reminder Button-->
    <Style x:Key="DeleteReminderButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontSize" Value="15"/>
        
        <!--On Hover-->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource WindowBackgroundBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!--Edit Reminder Button-->
    <Style x:Key="EditReminderButton" TargetType="{x:Type Button}" BasedOn="{StaticResource DeleteReminderButton}">
    </Style>
    
    <!--Mark Reminder As Done Button-->
    <Style x:Key="MarkReminderAsDoneButton" TargetType="{x:Type Button}" BasedOn="{StaticResource DeleteReminderButton}">
    </Style>
    
    <!--Delete Reminder Icon-->
    <Style x:Key="BinIcon" TargetType="{x:Type Path}" BasedOn="{StaticResource Icons}">
        <Setter Property="Data" Value="{StaticResource Bin}"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Width" Value="15"/>
        
        <!--On Hover-->
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}" Value="True">
                <Setter Property="Fill" Value="{StaticResource WindowBackgroundBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <!--Edit Reminder Icon-->
    <Style x:Key="EditIcon" TargetType="{x:Type Path}" BasedOn="{StaticResource Icons}">
        <Setter Property="Data" Value="{StaticResource Edit}"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Width" Value="15"/>
        
        <!--On Hover-->
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}" Value="True">
                <Setter Property="Fill" Value="{StaticResource WindowBackgroundBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
</ResourceDictionary>