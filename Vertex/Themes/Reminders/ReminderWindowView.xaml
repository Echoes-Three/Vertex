<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Styles Present Here-->
    
    <!--
    Reminder Content Input Placeholder
    Reminder Content Input
    Time Picker Scroll Background
    Time Picker-->
    
    <!--Reminder Content Input Placeholder-->
    <Style x:Key="ReminderContentInputPlaceholder" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource LightTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="MinHeight" Value="100"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Visibility" Value="Hidden"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, ElementName=ContentInput}" Value="">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
        
    </Style>
    
    <!--Reminder Content Input-->
    <Style x:Key="ReminderContentInput" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource LightTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AcceptsReturn" Value="True"/>
    </Style>
    
    <!--Time Picker Scroll Background-->
    <Style x:Key="TimePickerScrollBackground" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource LightBackgroundBrush}"/>
        
        <Style.Triggers>
            
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource LightTextBrush}"></Setter>
            </Trigger>
            
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=HourScroll}" Value="True">
                <Setter Property="Background" Value="{StaticResource LightTextBrush}"></Setter>
            </DataTrigger>
            
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=MinuteScroll}" Value="True">
                <Setter Property="Background" Value="{StaticResource LightTextBrush}"></Setter>
            </DataTrigger>
            
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=MeridiemScroll}" Value="True">
                <Setter Property="Background" Value="{StaticResource LightTextBrush}"></Setter>
            </DataTrigger>
            
        </Style.Triggers>
    </Style>
    
    <!--Time Picker-->
    <Style x:Key="TimePicker" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource LightTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="HorizontalAlignment" Value="Center"></Setter>
        
        <Style.Triggers>
            
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=TimePickerBackground}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DarkBackgroundBrush}"/>
            </DataTrigger>
            
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=HourScroll}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DarkBackgroundBrush}"/>
            </DataTrigger>
            
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=MinuteScroll}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DarkBackgroundBrush}"/>
            </DataTrigger>
            
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=MeridiemScroll}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DarkBackgroundBrush}"/>
            </DataTrigger>
            
        </Style.Triggers>
    </Style>
    
    <Style x:Key="CancelReminderEntry" TargetType="{x:Type Button}" BasedOn="{StaticResource DeleteReminderButton}">
    </Style>
    <Style x:Key="SaveReminderEntry" TargetType="{x:Type Button}" BasedOn="{StaticResource DeleteReminderButton}">
    </Style>
</ResourceDictionary>