<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Styles Present Here-->
    
    <!--
    Removes TextBox Style
    Reminder Content
    Reminder Date Info
    Edit Reminder Button Hover
    Edit Reminder Button
    Delete Reminder Button Hover
    Delete Reminder Button
    Show Reminder Action Buttons-->
    
    
    <!--Removes TextBox Style-->
    <Style x:Key="NoStyleTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="AllowDrop" Value="true"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBoxBase}">
                    <Border 
                        Name="Border"
                        CornerRadius="0" 
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0" >
                        <ScrollViewer Margin="0" x:Name="PART_ContentHost"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Foreground" Value="Transparent"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--Reminder Content-->
    <Style x:Key="ReminderContent" TargetType="{x:Type TextBox}" BasedOn="{StaticResource NoStyleTextBox}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="TextAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush-Gray-200}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="Margin" Value="5"/>
    </Style>
    
    <!--Reminder Date Info-->
    <Style x:Key="ReminderDateInfo" TargetType="{x:Type TextBlock}" >
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush-Gray-200}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        
    </Style>
    
    <!--Edit Reminder Button Hover-->
    <Style x:Key="EditReminderButtonHover" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Brush-Gray-600}"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding ElementName=EditReminderButton, Path=IsMouseOver}" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush-Gray-500}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--Edit Reminder Button-->
    <Style x:Key="EditReminderButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource Brush-Gray-400}"/>
        <Setter Property="Width" Value="30"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding ElementName=EditReminderButton, Path=IsMouseOver}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush-Gray-200}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <!--Delete Reminder Button Hover-->
    <Style x:Key="DeleteReminderButtonHover" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Brush-Gray-600}"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding ElementName=DeleteReminderButton, Path=IsMouseOver}" Value="True">
                <Setter Property="Background" Value="{StaticResource LipstickRedBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <!--Delete Reminder Button-->
    <Style x:Key="DeleteReminderButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource Brush-Gray-400}"/>
        <Setter Property="Width" Value="30"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding ElementName=DeleteReminderButton, Path=IsMouseOver}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush-Gray-700}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <!--Show Reminder Action Buttons-->
    <Style x:Key="ShowReminderActionButtons" TargetType="{x:Type Grid}">
        <Setter Property="Visibility" Value="Hidden"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding ElementName=MainGrid, Path=IsMouseOver}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
</ResourceDictionary>