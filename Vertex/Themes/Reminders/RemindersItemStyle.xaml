<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Styles Present Here-->
    
    <!--
    Reminder Content
    Reminder Set For Label
    Delete Reminder Button
    Edit Reminder Button
    Mark Reminder As Done Button
    Delete Reminder Icon
    Edit Reminder Icon-->
    
    <!--Reminder Content-->
    <Style x:Key="ReminderContent" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,15"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    
    <!--Reminder Set For Label-->
    <Style x:Key="ReminderSetForLabel" TargetType="{x:Type TextBlock}" >
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource DarkTextBrush}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"></Setter>
        
    </Style>
    
    <!--Delete Reminder Button-->
    <Style x:Key="DeleteReminderButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        
        <Style.Triggers>
            <!--On Hover-->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ExtraLightBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!--Edit Reminder Button-->
    <Style x:Key="EditReminderButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        
        <Style.Triggers>
            <!--On Hover-->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ExtraLightBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!--Mark Reminder As Done Button-->
    <Style x:Key="MarkReminderAsDoneButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BasicToggleButton}">
        
        <Style.Triggers>
            <!--On Hover-->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ExtraLightBackgroundBrush}"></Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!--Delete Reminder Icon-->
    <Style x:Key="DeleteReminderIcon" TargetType="{x:Type Path}" BasedOn="{StaticResource Icons}">
        <Setter Property="Data" Value="{StaticResource Bin}"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Width" Value="15"/>
        
        <!--On Hover-->
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}" Value="True">
                <Setter Property="Fill" Value="{StaticResource DarkBackgroundBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <!--Edit Reminder Icon-->
    <Style x:Key="EditReminderIcon" TargetType="{x:Type Path}" BasedOn="{StaticResource Icons}">
        <Setter Property="Data" Value="{StaticResource Edit}"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Width" Value="15"/>
        
        <!--On Hover-->
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}" Value="True">
                <Setter Property="Fill" Value="{StaticResource DarkBackgroundBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <!--Reminder CheckBox Icon-->
    <Style x:Key="ReminderCheckBoxIcon" TargetType="{x:Type Path}" BasedOn="{StaticResource Icons}">
        <Setter Property="Data" Value="{StaticResource EmptyCheckBox}"/>
        
        <Style.Triggers>
            
            <!--Binding-->
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=IsChecked}" Value="True">
                <Setter Property="Fill" Value="{StaticResource ExtraLightBackgroundBrush}"/>
                <Setter Property="Data" Value="{StaticResource SelectedCheckBox}"/>
            </DataTrigger>
            <!--On Hover-->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=IsChecked}" Value="True"/>
                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=IsMouseOver}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.Setters>
                    <Setter Property="Fill" Value="{StaticResource LightTextBrush}"/>
                </MultiDataTrigger.Setters>
            </MultiDataTrigger>
        </Style.Triggers>
        
    </Style>
    
</ResourceDictionary>