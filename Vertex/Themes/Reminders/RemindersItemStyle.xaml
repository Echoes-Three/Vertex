<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Styles Present Here-->
    
    <!--
    Reminder Content
    Reminder Set For Label
    Delete Reminder Button
    Edit Reminder Button
    Delete Reminder Icon
    Edit Reminder Icon-->
    
    <!--Reminder Content-->
    <Style x:Key="ReminderContent" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{DynamicResource MediumTextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,15"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    
    <!--Reminder Set For Label-->
    <Style x:Key="ReminderSetForLabel" TargetType="{x:Type TextBlock}" >
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource ExtraDarkTextBrush}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"></Setter>
        
    </Style>
    
    <!--Delete Reminder Button-->
    <Style x:Key="DeleteReminderButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Width" Value="30"/>
        
        <!--On Hover-->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource LipstickRedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!--Edit Reminder Button-->
    <Style x:Key="EditReminderButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Width" Value="30"/>
        
        <!--On Hover-->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource LightBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!--Delete Reminder Icon-->
    <Style x:Key="DeleteReminderIcon" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="Thin"/>
        <Setter Property="Foreground" Value="{StaticResource LightTextBrush}"/>
    </Style>
    
    <!--Edit Reminder Icon-->
    <Style x:Key="EditReminderIcon" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DeleteReminderIcon}">
    </Style>
    
</ResourceDictionary>