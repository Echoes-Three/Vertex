<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Styles Present Here-->
    
    <!--
    Reminders Tab Tittle
    Add Reminder Button
    Reminder History ToggleButton
    Sort Reminders Button
    Reminders Done Placeholder Message
    Reminders ScrollViewer
    Reminders History ScrollViewer
    Add Reminder Icon
    Reminders History Icon
    Sort Reminders Icon-->
    
    <!--Reminders Tab Tittle-->
    <Style x:Key="ReminderTabTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="Foreground" Value="{DynamicResource LightTextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
    </Style>
    
    <!--Add Reminder Button-->
    <Style x:Key="AddReminderButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        <Setter Property="Width" Value="35"/>
        <Setter Property="Height" Value="35"/>
        
        <!--On Hover-->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource LightBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
        
    </Style>

    <Style x:Key="ReminderHistoryToggleButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BasicToggleButton}">
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="35"/>
            
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                    <Setter Property="Background" Value="{StaticResource LightTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
            
        </Style>
    
    <!--Add Reminder icon-->
    <Style x:Key="AddIcon" TargetType="{x:Type Path}" BasedOn="{StaticResource Icons}">
        <Setter Property="Data" Value="{StaticResource Add}"/>
        
        <!--On Hover-->
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}" Value="True">
                <Setter Property="Fill" Value="{StaticResource LightTextBrush}"/>
            </DataTrigger>
        </Style.Triggers>
        
    </Style>
    
    
</ResourceDictionary>