<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Styles Present Here-->
    
    <!--
    Reminders Tab Tittle
    Add Reminder Button
    Reminder History ToggleButton
    Sort Reminders Button
    Reminders Done Placeholder Message
    Reminders ScrollViewer
    Reminders History ScrollViewer
    Add Reminder Icon
    Reminders History Icon
    Sort Reminders Icon-->
    
    <!--Reminders Tab Tittle-->
    <Style x:Key="ReminderTabTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
    </Style>
    
    <!--Add Reminder Button-->
    <Style x:Key="AddReminderButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
        <Setter Property="Width" Value="35"/>
        <Setter Property="Height" Value="35"/>
        
        <!--On Hover-->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TextBrush}"/>
            </Trigger>
        </Style.Triggers>
        
    </Style>

    <!--Reminder History ToggleButton-->
    <Style x:Key="ReminderHistoryToggleButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BasicToggleButton}">
        <Setter Property="Width" Value="35"/>
        <Setter Property="Height" Value="35"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                <Setter Property="Background" Value="{StaticResource TextBrush}"/>
            </DataTrigger>
        </Style.Triggers>
        
    </Style>
    
    <!--Sort Reminders Button-->
    <Style x:Key="SortButton" TargetType="{x:Type Button}" BasedOn="{StaticResource AddReminderButton}">
    </Style>
    
    <!--Reminders Not Done Placeholder Message-->
    <Style x:Key="RemindersNotDonePlaceholderMessage" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ReminderTabTitle}">
        <Setter Property="Foreground" Value="{StaticResource ButtonBackgroundBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Visibility" Value="Visible"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="False">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                <Setter Property="Visibility" Value="Hidden"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <!--Reminders Done Placeholder Message-->
    <Style x:Key="RemindersDonePlaceholderMessage" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ReminderTabTitle}">
        <Setter Property="Foreground" Value="{StaticResource ButtonBackgroundBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Visibility" Value="Hidden"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="False">
                <Setter Property="Visibility" Value="Hidden"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <!--Reminders ScrollViewer-->
    <Style x:Key="ReminderHistoryIsOff" TargetType="{x:Type ScrollViewer}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="False">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                <Setter Property="Visibility" Value="Hidden"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <!--Reminders History ScrollViewer-->
    <Style x:Key="ReminderHistoryIsOn" TargetType="{x:Type ScrollViewer}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="False">
                <Setter Property="Visibility" Value="Hidden"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <!--Edit-->
    <Style x:Key="EditIcon" TargetType="{x:Type Path}" BasedOn="{StaticResource Icons}">
        <Setter Property="Data" Value="{StaticResource Edit}"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Width" Value="15"/>
    </Style>
    
    <Style x:Key="ArrowUpIcon" TargetType="{x:Type Path}" BasedOn="{StaticResource Icons}">
        <Setter Property="Data" Value="{StaticResource ArrowUp}"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,35"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        
        <Style.Triggers>
            <!--On Hover-->
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=RemindDay}" Value="True">
                <Setter Property="Fill" Value="{StaticResource WindowBackgroundBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="ArrowDownIcon" TargetType="{x:Type Path}" BasedOn="{StaticResource Icons}">
        <Setter Property="Data" Value="{StaticResource ArrowDown}"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="Margin" Value="0,35,0,0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        
        <Style.Triggers>
            <!--On Hover-->
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=RemindDay}" Value="True">
                <Setter Property="Fill" Value="{StaticResource WindowBackgroundBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <!--Add Reminder icon-->
    <Style x:Key="AddIcon" TargetType="{x:Type Path}" BasedOn="{StaticResource Icons}">
        <Setter Property="Data" Value="{StaticResource Add}"/>
        
        <!--On Hover-->
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}" Value="True">
                <Setter Property="Fill" Value="{StaticResource WindowBackgroundBrush}"/>
            </DataTrigger>
        </Style.Triggers>
        
    </Style>
    
    <!--Reminders History Icon-->
    <Style x:Key="HistoryIcon" TargetType="{x:Type Path}" BasedOn="{StaticResource Icons}">
        <Setter Property="Data" Value="{StaticResource History}"/>
        
        <!--On Hover-->
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=IsMouseOver}" Value="True">
                <Setter Property="Fill" Value="{StaticResource WindowBackgroundBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Tag}" Value="True">
                <Setter Property="Fill" Value="{StaticResource WindowBackgroundBrush}"/>
            </DataTrigger>
        </Style.Triggers>
        
    </Style>
    
    <!-- Sort Reminders Icon -->
    <Style x:Key="SortIcon" TargetType="{x:Type Path}" BasedOn="{StaticResource Icons}">
        <Setter Property="Data" Value="{StaticResource Closest}"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="Width" Value="25"/>
        
        <!--Icon Change--><!--On Hover-->
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}" Value="True">
                <Setter Property="Fill" Value="{StaticResource WindowBackgroundBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Closest">
                <Setter Property="Data" Value="{StaticResource Closest}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Created">
                <Setter Property="Data" Value="{StaticResource Created}"/>
            </DataTrigger>
        </Style.Triggers>
        
    </Style>
    
</ResourceDictionary>