<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Basic TextBlock Style-->
    <Style x:Key="BasicTextBlock" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
    </Style>
    
    <Style x:Key="Percentage" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BasicTextBlock}">
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="FontSize" Value="15"/>
        
        <Style.Triggers>
            <Trigger Property="Tag" Value="Percentage">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Trigger>
            
            <Trigger Property="Tag" Value="WeekDays">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Trigger>
            
        </Style.Triggers>
    </Style>
    
    <Style x:Key="WeekDays" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Percentage}"></Style>
    
    <Style x:Key="MediumTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BasicTextBlock}">
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>
    
    <Style x:Key="ReminderContentTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BasicTextBlock}">
        <Setter Property="MinHeight" Value="100"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Margin" Value="10"/>
        
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TextBox}, Path=Text}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
        
    </Style>
    
    <Style x:Key="RemindDayScroll" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ReminderContentTextBlock}">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Cursor" Value="ScrollNS"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Center"></Setter>
        
        <Style.Triggers>
            
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource WindowBackgroundBrush}"></Setter>
            </Trigger>
            
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource WindowBackgroundBrush}"/>
            </DataTrigger>
            
        </Style.Triggers>
    </Style>
    
    <Style x:Key="RemindDayScrollBackground" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush}"/>
        
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TextBrush}"></Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="TimePicker" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ReminderContentTextBlock}">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Cursor" Value="ScrollNS"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="HorizontalAlignment" Value="Center"></Setter>
        
        <Style.Triggers>
            
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=TimePickerBackground}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource WindowBackgroundBrush}"/>
            </DataTrigger>
            
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=HourScroll}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource WindowBackgroundBrush}"/>
            </DataTrigger>
            
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=MinuteScroll}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource WindowBackgroundBrush}"/>
            </DataTrigger>
            
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=MeridiemScroll}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource WindowBackgroundBrush}"/>
            </DataTrigger>
            
        </Style.Triggers>
    </Style>
    
    <Style x:Key="TimePickerScrollBackground" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush}"/>
        
        <Style.Triggers>
            
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TextBrush}"></Setter>
            </Trigger>
            
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=HourScroll}" Value="True">
                <Setter Property="Background" Value="{StaticResource TextBrush}"></Setter>
            </DataTrigger>
            
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=MinuteScroll}" Value="True">
                <Setter Property="Background" Value="{StaticResource TextBrush}"></Setter>
            </DataTrigger>
            
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=MeridiemScroll}" Value="True">
                <Setter Property="Background" Value="{StaticResource TextBrush}"></Setter>
            </DataTrigger>
            
            
        </Style.Triggers>
    </Style>
    
    <Style x:Key="ReminderContentPlaceholder" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BasicTextBlock}">
        <Setter Property="MinHeight" Value="100"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Visibility" Value="Hidden"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, ElementName=ContentInput}" Value="">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
        
    </Style>
    
    
    
    <Style x:Key="TextInput" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    
    <Style x:Key="ReminderInput" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    
</ResourceDictionary>