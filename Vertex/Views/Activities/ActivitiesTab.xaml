<UserControl x:Class="Vertex.Views.Activities.ActivitiesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             DataContext="{Binding ActivitiesVM}"
             xmlns:activitiesView="clr-namespace:Vertex.Views.Activities"
             xmlns:activities="clr-namespace:Vertex.ViewModels.Activities"
             mc:Ignorable="d"
             d:DesignHeight="840" d:DesignWidth="400"
             d:DataContext="{d:DesignInstance Type=activities:ActivitiesViewModel}">
    
    <Grid Background="Transparent">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="15"/> <!--Spacer-->
            <RowDefinition Height="25"/> <!--Title-->
            <RowDefinition Height="40"/> <!--Spacer-->
            <RowDefinition Height="760"/> <!--Activities-->
        </Grid.RowDefinitions>
        
        <TextBlock
            Grid.Row="1"
            Text="ACTIVITIES"
            Style="{StaticResource ActivitiesTabTitle}"/> <!--Tab Tittle-->
        
       <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="360"/> <!--VE-->
                <RowDefinition Height="84"/> <!--VE-->
                <RowDefinition Height="316"/> <!--VE-->
            </Grid.RowDefinitions>
           
            <TextBlock 
                Grid.Row="0"
                Grid.RowSpan="2"
                Text="⍹"
                FontFamily="{StaticResource JetBrainsMono}"
                FontSize="450"
                FontWeight="Regular"
                VerticalAlignment="Bottom"
                Margin="0,0,0,30"
                HorizontalAlignment="Center"
                Opacity="0.01"
                Foreground="{StaticResource Brush-Gray-100}"/> <!--Upper Text Element-->
            
            <TextBlock 
                Grid.Row="1"
                Text="ANTEA"
                FontFamily="{StaticResource JetBrainsMono}"
                FontSize="70"
                FontWeight="Bold"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Opacity="0.01"
                Foreground="{StaticResource Brush-Gray-100}"/> <!--Middle Text Element-->
            
            
            <TextBlock 
                Grid.Row="2"
                Text="08 09 07 01 19 08 09 11 01 20 01&#x0a;10 15 19 21 11 05"
                FontFamily="{StaticResource JetBrainsMono}"
                FontSize="10"
                FontWeight="bold"
                VerticalAlignment="Bottom" HorizontalAlignment="Left"
                Opacity="0.05"
                Foreground="{StaticResource Brush-Gray-100}"/> <!--Bottom Left Visual Element-->
            
            <TextBlock 
               Grid.Row="2"
               Text="10 10 02 01"
               FontFamily="{StaticResource JetBrainsMono}"
               FontSize="10"
               FontWeight="bold"
               VerticalAlignment="Bottom" HorizontalAlignment="Right"
               Opacity="0.05"
               Foreground="{StaticResource Brush-Gray-100}"/> <!--Bottom Right Visual Element-->
           
        </Grid> <!--VE-->
        
        
        <ScrollViewer 
            Grid.Row="3" 
            VerticalScrollBarVisibility="Auto">
            
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}">
                    <Setter Property="Width" Value="0"/>
                    <Setter Property="MinWidth" Value="0"/>
                </Style>
            </ScrollViewer.Resources>
            
            <ItemsControl ItemsSource="{Binding TodayActivities}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <activitiesView:ActivitiesItem/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
        </ScrollViewer> <!--Activities-->
    </Grid>
</UserControl>
