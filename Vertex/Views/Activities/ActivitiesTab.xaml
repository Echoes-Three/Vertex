<UserControl x:Class="Vertex.Views.Activities.ActivitiesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             DataContext="{Binding ActivitiesVM}"
             xmlns:activitiesView="clr-namespace:Vertex.Views.Activities"
             xmlns:activities="clr-namespace:Vertex.ViewModels.Activities"
             mc:Ignorable="d"
             d:DesignHeight="553" d:DesignWidth="504"
             d:DataContext="{d:DesignInstance Type=activities:ActivitiesViewModel}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/> <!--Spacer-->
            <RowDefinition Height="8*"/> <!--Tab-->
            <RowDefinition Height="2*"/> <!--Spacer-->
            <RowDefinition Height="86*"/> <!--Activities Content-->
            <RowDefinition Height="2*"/> <!--Spacer-->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/> <!--Spacer-->
            <ColumnDefinition Width="96*"/> <!--Tab Title & Activities Content-->
            <ColumnDefinition Width="2*"/> <!--Spacer-->
        </Grid.ColumnDefinitions>
        
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="82*"/> <!--Tab Tittle-->
                <ColumnDefinition Width="1*"/> <!--Spacer-->
                <ColumnDefinition Width="8*"/> <!--Show All Activities Toggle Button-->
                <ColumnDefinition Width="1*"/> <!--Spacer-->
                <ColumnDefinition Width="8*"/> <!--Add New Activity Button-->
            </Grid.ColumnDefinitions>
            
            <TextBlock
                Grid.Column="0"
                Text="ACTIVITIES"
                Foreground="{StaticResource LightTextBrush}"
                Style="{StaticResource ActivitiesTabTitle}"/> <!--Tab Tittle-->
            
            <ToggleButton 
                Grid.Column="2"
                IsChecked="{Binding ShowRemainingActivities}"
                Style="{StaticResource ShowRemainingActivitiesToggleButton}"
                Tag="{Binding ShowRemainingActivities}">
                <TextBlock 
                    Style="{StaticResource ShowAllIconActivities}"
                    Text="∞"/>
            </ToggleButton> <!--Show All Activities Toggle Button-->
            
            <Button 
                Grid.Column="4"
                Style="{StaticResource AddNewActivityButton}"
                Command="{Binding OnAddActivityView}">
                <TextBlock 
                    Style="{StaticResource AddNewActivityIcon}"
                    Text="+"/>
            </Button> <!--Add New Reminder Button-->
            
            <!--<TextBlock 
                Grid.Column="0" 
                Text="❮❮❮❮"
                FontFamily="{StaticResource JetBrainsMono}"
                FontSize="100"
                FontWeight="bold"
                Margin="180,0,0,0"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                IsHitTestVisible="False"
                Foreground="{StaticResource LightTextBrush}"/> ~1~Visual Element@1@-->
            
        </Grid> <!--Tab Buttons-->
        
        
        <ScrollViewer Grid.Row="3" Grid.Column="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource ShowAllActivitiesIsOff}"
                      Tag="{Binding ShowRemainingActivities}">
            
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ScrollBar}"/>
            </ScrollViewer.Resources>
            
            <ItemsControl ItemsSource="{Binding TodayActivities}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <activitiesView:ActivitiesItem/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
        </ScrollViewer> <!--Today's Activities-->
        <ScrollViewer Grid.Row="3" Grid.Column="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource ShowRemainingActivitiesIsOn}"
                      Tag="{Binding ShowRemainingActivities}">
            
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ScrollBar}"/>
            </ScrollViewer.Resources>
            
            <ItemsControl ItemsSource="{Binding RemainingActivities}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <activitiesView:ActivitiesItem/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
        </ScrollViewer> <!--Remaining Activities-->
    </Grid>
</UserControl>
