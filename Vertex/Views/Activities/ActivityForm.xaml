<UserControl x:Class="Vertex.Views.Activities.ActivityForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:activities="clr-namespace:Vertex.ViewModels.Activities"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="400"
             d:DataContext="{d:DesignInstance Type=activities:ActivityFormViewModel}">
    
    <Border Background="{StaticResource Brush-Gray-800}">
        <Grid>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="260" /> <!--Input Fields-->
                    <RowDefinition Height="228" /> <!--Spacer-->
                    <RowDefinition Height="130" /> <!--Duration Picker + Color Picker-->
                    <RowDefinition Height="20" /> <!--Spacer-->
                    <RowDefinition Height="52" /> <!--Days of Week-->
                    <RowDefinition Height="20" /> <!--Spacer-->
                    <RowDefinition Height="40" /> <!--Send Button-->
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/> <!--Title-->
                        <RowDefinition Height="20"/> <!--Spacer-->
                        <RowDefinition Height="210"/> <!--Content-->
                    </Grid.RowDefinitions>
                    
                    <TextBlock
                        Grid.Row="0"
                        Style="{StaticResource ActivityTitleInputPlaceholder}"
                        Text="Title" /> <!--Title Placeholder-->
                    <TextBlock
                        Grid.Row="2"
                        Style="{StaticResource ActivityContentInputPlaceholder}"
                        Text="Content" /> <!--Content Placeholder-->
                    
                    <TextBlock 
                        Grid.Row="0"
                        Text="{Binding TitleLimitIndicator, FallbackValue=25}"
                        Style="{StaticResource ActivityLimitIndicator}"/> <!--Title Character Limit Indicator-->
                    <TextBlock 
                        Grid.Row="2"
                        Text="{Binding ContentLimitIndicator, FallbackValue=500}"
                        Tag="Content"
                        Style="{StaticResource ActivityLimitIndicator}"/> <!--Content Character Limit Indicator-->
                    
                    <TextBox
                        Grid.Row="0"
                        x:Name="TitleInput"
                        Style="{StaticResource ActivityTitleInput}"
                        Text="{Binding ActivityTitle, UpdateSourceTrigger=PropertyChanged, FallbackValue=Title}" /> <!--Title Input-->
                    <TextBox
                        Grid.Row="2"
                        x:Name="ContentInput"
                        Style="{StaticResource ActivityContentInput}"
                        Text="{Binding ActivityContent, UpdateSourceTrigger=PropertyChanged, FallbackValue=content}" /> <!--Content Input-->
    
                    <Border
                        Grid.Row="0"
                        Width="5"
                        HorizontalAlignment="Left"
                        Background="{StaticResource Brush-Gray-700}"/> <!--Title Guide Bar-->
                    <Border
                        Grid.Row="2"
                        Width="5"
                        HorizontalAlignment="Left"
                        Background="{StaticResource Brush-Gray-700}"/> <!--Content Guide Bar-->
                    
                </Grid> <!--Input Fields-->
                
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/> <!--Duration Picker-->
                        <ColumnDefinition Width="10"/> <!--Spacer-->
                        <ColumnDefinition Width="130"/> <!--Color Picker-->
                    </Grid.ColumnDefinitions>
                    
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" /> <!--Up Button-->
                            <RowDefinition Height="90" /> <!--Digits-->
                            <RowDefinition Height="20" /> <!--Down Buttons-->
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" /><!--Spacer-->
                            <ColumnDefinition Width="100" /> <!--HH-->
                            <ColumnDefinition Width="20" /><!--:-->
                            <ColumnDefinition Width="100" /><!--MM-->
                            <ColumnDefinition Width="20" /><!--Spacer-->
                        </Grid.ColumnDefinitions>
    
                        <Border
                            Grid.Row="1"
                            Grid.Column="0" Grid.ColumnSpan="5"
                            Background="{StaticResource Brush-Gray-700}"/><!--Background-->
    
                        <Border
                            Grid.Row="0" Grid.RowSpan="3"
                            Grid.Column="1"
                            Background="{StaticResource Brush-Gray-700}"/><!--HH Background-->
                        <Border
                            Grid.Row="0" Grid.RowSpan="3"
                            Grid.Column="3"
                            Background="{StaticResource Brush-Gray-700}"/><!--MM Background-->
                        
                        <Path
                            Grid.Row="1" Grid.Column="2" 
                            Height="24"
                            Data="M 0,0 L 92,0 L 46,85 L 92,170 L 0,170 L 46,85 Z"
                            Fill="{StaticResource Brush-Gray-500}"
                            Stretch="Uniform"/> <!--VE-->
                        
                        <Button
                            Grid.Row="0" Grid.Column="1" 
                            Command="{Binding OnPickDuration}"
                            CommandParameter="HU">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush-Gray-600}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button> <!--HH Up Button-->
                        <Button
                            Grid.Row="2" Grid.Column="1" 
                            Command="{Binding OnPickDuration}"
                            CommandParameter="HD">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush-Gray-600}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button> <!--HH Down Button-->
                        
                        <Button
                            Grid.Row="0" Grid.Column="3" 
                            Command="{Binding OnPickDuration}"
                            CommandParameter="MU">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush-Gray-600}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button> <!--MM Up Button-->
                        <Button
                            Grid.Row="2" Grid.Column="3" 
                            Command="{Binding OnPickDuration}"
                            CommandParameter="MD">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BasicButton}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush-Gray-600}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button> <!--MM Down Button-->
                        
                        <TextBlock
                            Grid.Row="0" Grid.Column="1" 
                            Text="+"
                            Style="{StaticResource DurationPickerButtonIcon}"/> <!--Button Icon-->
                        <TextBlock
                            Grid.Row="2" Grid.Column="1" 
                            Text="+"
                            Style="{StaticResource DurationPickerButtonIcon}"/> <!--Button Icon-->
                        
                        <TextBlock
                            Grid.Row="0" Grid.Column="3" 
                            Text="+"
                            Style="{StaticResource DurationPickerButtonIcon}"/> <!--Button Icon-->
                        <TextBlock
                            Grid.Row="2" Grid.Column="3" 
                            Text="+"
                            Style="{StaticResource DurationPickerButtonIcon}"/> <!--Button Icon-->
                        
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            IsHitTestVisible="False"
                            Style="{StaticResource DurationPickerDigits}"
                            Text="{Binding DurationHour, FallbackValue=00}"/> <!--HH-->
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="3"
                            IsHitTestVisible="False"
                            Style="{StaticResource DurationPickerDigits}"
                            Text="{Binding DurationMinute, FallbackValue=00}"/> <!--MM-->
                            
                    </Grid> <!--Duration Picker-->
                    
                    <Grid Grid.Column="2">
                        
                        <Border
                            Width="130"
                            Height="130"
                            Background="{StaticResource Brush-Gray-700}"/> <!--Color PIcker Background-->
                        
                        <Border
                            Width="15"
                            Height="8"
                            Background="{StaticResource Brush-Gray-500}"
                            IsHitTestVisible="False"
                            VerticalAlignment="Top" HorizontalAlignment="Left"/> <!--VE TL-->
                        <Border
                            Width="15"
                            Height="8"
                            Background="{StaticResource Brush-Gray-500}"
                            IsHitTestVisible="False"
                            VerticalAlignment="Top" HorizontalAlignment="Right"/> <!--VE TR-->
                        <Border
                            Width="15"
                            Height="8"
                            Background="{StaticResource Brush-Gray-500}"
                            IsHitTestVisible="False"
                            VerticalAlignment="Bottom" HorizontalAlignment="Left"/> <!--VE BL-->
                        <Border
                            Width="15"
                            Height="8"
                            Background="{StaticResource Brush-Gray-500}"
                            IsHitTestVisible="False"
                            VerticalAlignment="Bottom" HorizontalAlignment="Right"/> <!--VE BR-->
                        
                        <Border
                            Background="{Binding SelectedColor, FallbackValue=Red}"
                            Style="{StaticResource Color}"/> <!--Color-->
                        
                        <Border
                            Style="{StaticResource ColorCover}"/> <!--Color Cover-->
                        
                        <Button
                            x:Name="ColorPicker"
                            Height="80"
                            Width="80"
                            Command="{Binding OnChangeColor}"
                            Style="{StaticResource BasicButton}"/> <!--Color Picker Interactable-->
                        
                        <Border 
                            Style="{StaticResource ReticleTL}"/> <!--Reticle TL-->
                        <Border 
                            Style="{StaticResource ReticleTR}"/> <!--Reticle TR-->
                        <Border 
                            Style="{StaticResource ReticleBL}"/> <!--Reticle BL-->
                        <Border 
                            Style="{StaticResource ReticleBR}"/> <!--Reticle Br-->
                        
                        <Border
                            Width="10"
                            Height="10"
                            IsHitTestVisible="False"
                            Background="{StaticResource Brush-Gray-600}"/> <!--VE-->
                        
                    </Grid> <!--Color Picker-->
                    
                </Grid> <!--Duration Picker + Color Picker-->
                    
                <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" /> <!--Sun-->
                                <ColumnDefinition Width="6" /> <!--Midsection-->
                                <ColumnDefinition Width="52" /> <!--Mon-->
                                <ColumnDefinition Width="6" /> <!--Midsection-->
                                <ColumnDefinition Width="52" /> <!--Tue-->
                                <ColumnDefinition Width="6" /> <!--Midsection-->
                                <ColumnDefinition Width="52" /> <!--Wed-->
                                <ColumnDefinition Width="6" /> <!--Midsection-->
                                <ColumnDefinition Width="52" /> <!--Thu-->
                                <ColumnDefinition Width="6" /> <!--Midsection-->
                                <ColumnDefinition Width="52" /> <!--Fri-->
                                <ColumnDefinition Width="6" /> <!--Midsection-->
                                <ColumnDefinition Width="52" /> <!--Sat-->
                            </Grid.ColumnDefinitions>
        
                            <Border 
                                Grid.Column="0" Grid.ColumnSpan="3">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Height" Value="30"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Background" Value="{StaticResource Brush-Gray-700}"/>
                                            
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ElementName=Sun, Path=IsChecked}" Value="True"/>
                                                        <Condition Binding="{Binding ElementName=Mon, Path=IsChecked}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.Setters>
                                                        <Setter Property="Background" Value="{StaticResource VividRoyalBrush}"/>
                                                    </MultiDataTrigger.Setters>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border> <!--Midsection-->
                            <Border 
                                Grid.Column="2" Grid.ColumnSpan="3">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Height" Value="30"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Background" Value="{StaticResource Brush-Gray-700}"/>
                                        
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=Mon, Path=IsChecked}" Value="True"/>
                                                    <Condition Binding="{Binding ElementName=Tue, Path=IsChecked}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.Setters>
                                                    <Setter Property="Background" Value="{StaticResource VividRoyalBrush}"/>
                                                </MultiDataTrigger.Setters>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border> <!--Midsection-->
                            <Border 
                                Grid.Column="4" Grid.ColumnSpan="3">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Height" Value="30"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Background" Value="{StaticResource Brush-Gray-700}"/>
                                        
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=Tue, Path=IsChecked}" Value="True"/>
                                                    <Condition Binding="{Binding ElementName=Wed, Path=IsChecked}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.Setters>
                                                    <Setter Property="Background" Value="{StaticResource VividRoyalBrush}"/>
                                                </MultiDataTrigger.Setters>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border> <!--Midsection-->
                            <Border 
                                Grid.Column="6" Grid.ColumnSpan="3">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Height" Value="30"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Background" Value="{StaticResource Brush-Gray-700}"/>
                                        
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=Wed, Path=IsChecked}" Value="True"/>
                                                    <Condition Binding="{Binding ElementName=Thu, Path=IsChecked}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.Setters>
                                                    <Setter Property="Background" Value="{StaticResource VividRoyalBrush}"/>
                                                </MultiDataTrigger.Setters>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border> <!--Midsection-->
                            <Border 
                                Grid.Column="8" Grid.ColumnSpan="3">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Height" Value="30"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Background" Value="{StaticResource Brush-Gray-700}"/>
                                        
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=Thu, Path=IsChecked}" Value="True"/>
                                                    <Condition Binding="{Binding ElementName=Fri, Path=IsChecked}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.Setters>
                                                    <Setter Property="Background" Value="{StaticResource VividRoyalBrush}"/>
                                                </MultiDataTrigger.Setters>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border> <!--Midsection-->
                            <Border 
                                Grid.Column="10" Grid.ColumnSpan="3">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Height" Value="30"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Background" Value="{StaticResource Brush-Gray-700}"/>
                                        
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=Fri, Path=IsChecked}" Value="True"/>
                                                    <Condition Binding="{Binding ElementName=Sat, Path=IsChecked}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.Setters>
                                                    <Setter Property="Background" Value="{StaticResource VividRoyalBrush}"/>
                                                </MultiDataTrigger.Setters>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border> <!--Midsection-->
                        
                            <ToggleButton
                                x:Name="Sun"
                                Grid.Column="0"
                                Content="S"
                                IsChecked="{Binding Sun}"
                                Style="{StaticResource WeekDayToggleButton}" /> <!--Sun-->
                            <ToggleButton
                                x:Name="Mon"
                                Grid.Column="2"
                                Content="M"
                                IsChecked="{Binding Mon}"
                                Style="{StaticResource WeekDayToggleButton}" /> <!--Mon-->
                            <ToggleButton
                                x:Name="Tue"
                                Grid.Column="4"
                                Content="T"
                                IsChecked="{Binding Tue}"
                                Style="{StaticResource WeekDayToggleButton}" /> <!--Tue-->
                            <ToggleButton
                                x:Name="Wed"
                                Grid.Column="6"
                                Content="W"
                                IsChecked="{Binding Wed}"
                                Style="{StaticResource WeekDayToggleButton}" /> <!--Wed-->
                            <ToggleButton
                                x:Name="Thu"
                                Grid.Column="8"
                                Content="T"
                                IsChecked="{Binding Thu}"
                                Style="{StaticResource WeekDayToggleButton}" /> <!--Thu-->
                            <ToggleButton
                                x:Name="Fri"
                                Grid.Column="10"
                                Content="F"
                                IsChecked="{Binding Fri}"
                                Style="{StaticResource WeekDayToggleButton}" /> <!--Fri-->
                            <ToggleButton
                                x:Name="Sat"
                                Grid.Column="12"
                                Content="S"
                                IsChecked="{Binding Sat}"
                                Style="{StaticResource WeekDayToggleButton}" /> <!--Sat-->
                            
                        </Grid> <!--Weekdays-->
                    
                <Grid Grid.Row="6">
                        
                        <Border
                            x:Name="HoverAnimationHolder"
                            MouseEnter="MouseEnterSaveButton"
                            MouseLeave="MouseLeaveSaveButton"
                            Tag="{Binding ShowWarning}">
                            <Button
                                Background="{StaticResource Brush-Gray-700}"
                                Style="{StaticResource BasicButton}"
                                Command="{Binding OnSaveActivity}"/>
                            
                        </Border> <!--Save Buton / hover Animation-->
                        
                        <ItemsControl 
                            ItemsSource="{Binding Squares}" 
                            IsHitTestVisible="False"
                            SnapsToDevicePixels="True">
        
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="2" Columns="20"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
        
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Cell"
                                            Style="{StaticResource SaveButtonHoverAnimationColor}"
                                            Opacity="0"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Cell"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="0:0:0.1"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Cell"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="0:0:0.1"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                            
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
        
                        </ItemsControl> <!--Save Button Hover Animation-->
                        
                        <TextBlock
                            Text="-->"
                            IsHitTestVisible="False"
                            Style="{StaticResource SaveButtonTextOnHover}"/>
                        
                        
                    </Grid> <!--Save Button-->
                
            </Grid>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/> <!--Spacer-->
                    <RowDefinition Height="150"/> <!--Warning-->
                    <RowDefinition Height="20"/> <!--Spacer-->
                    <RowDefinition Height="40"/> <!--Button Space-->
                </Grid.RowDefinitions>
                
                <Grid
                    Grid.Row="1"
                    Style="{StaticResource WarningHover}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/> <!--Corner-->
                        <RowDefinition Height="90"/> <!--Content-->
                        <RowDefinition Height="30"/> <!--Corner-->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/> <!--Spacer-->
                        <ColumnDefinition Width="30"/> <!--Corner-->
                        <ColumnDefinition Width="{Binding MainWidth, FallbackValue=340}"/> <!--Content-->
                        <ColumnDefinition Width="30"/> <!--Corner-->
                        <ColumnDefinition Width="*"/> <!--Spacer-->
                    </Grid.ColumnDefinitions>
                    
                    <Border
                        Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" 
                        Background="{StaticResource LipstickRedBrush}"/> <!--Content Background-->
                    
                    <Border
                        Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" 
                        Background="{StaticResource LipstickRedBrush}"/> <!--Corner-->
                    <Border
                        Grid.Row="0" Grid.RowSpan="3" Grid.Column="3" 
                        Background="{StaticResource LipstickRedBrush}"/> <!--Corner-->
                    
                    <Border
                        Grid.Row="1" Grid.Column="1" 
                        Width="10" Height="10"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Background="{StaticResource Brush-Gray-700}"/> <!--VE-->
                    <Border
                        Grid.Row="1" Grid.Column="1" 
                        Width="10" Height="10"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Left"
                        Background="{StaticResource Brush-Gray-700}"/> <!--VE-->
                    <Border
                        Grid.Row="1" Grid.Column="3" 
                        Width="10" Height="10"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Right"
                        Background="{StaticResource Brush-Gray-700}"/> <!--VE-->
                    <Border
                        Grid.Row="1" Grid.Column="3" 
                        Width="10" Height="10"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Background="{StaticResource Brush-Gray-700}"/> <!--VE-->
                    
                    <Path 
                        Grid.Row="0" Grid.Column="1"
                        Fill="{StaticResource Brush-Gray-700}"
                        Stretch="Uniform"
                        Width="20" Height="20"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        IsHitTestVisible="False"
                        Data="M3,1 L4,1 L4,2 L3,2 Z
                              M1,2 L3,2 L3,3 L2,3 L2,4 L3,4 L3,5 L1,5 Z
                              M4,2 L6,2 L6,5 L4,5 L4,4 L5,4 L5,3 L4,3 Z
                              M3,5 L4,5 L4,6 L3,6 Z" /> <!--VE-->
                    <Path 
                        Grid.Row="2" Grid.Column="1"
                        Fill="{StaticResource Brush-Gray-700}"
                        Stretch="Uniform"
                        Width="20" Height="20"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        IsHitTestVisible="False"
                        Data="M3,1 L4,1 L4,2 L3,2 Z
                              M1,2 L3,2 L3,3 L2,3 L2,4 L3,4 L3,5 L1,5 Z
                              M4,2 L6,2 L6,5 L4,5 L4,4 L5,4 L5,3 L4,3 Z
                              M3,5 L4,5 L4,6 L3,6 Z" /> <!--VE-->
                    <Path 
                        Grid.Row="2" Grid.Column="3"
                        Fill="{StaticResource Brush-Gray-700}"
                        Stretch="Uniform"
                        Width="20" Height="20"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        IsHitTestVisible="False"
                        Data="M3,1 L4,1 L4,2 L3,2 Z
                              M1,2 L3,2 L3,3 L2,3 L2,4 L3,4 L3,5 L1,5 Z
                              M4,2 L6,2 L6,5 L4,5 L4,4 L5,4 L5,3 L4,3 Z
                              M3,5 L4,5 L4,6 L3,6 Z" /> <!--VE-->
                    <Path 
                        Grid.Row="0" Grid.Column="3"
                        Fill="{StaticResource Brush-Gray-700}"
                        Stretch="Uniform"
                        Width="20" Height="20"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        IsHitTestVisible="False"
                        Data="M3,1 L4,1 L4,2 L3,2 Z
                              M1,2 L3,2 L3,3 L2,3 L2,4 L3,4 L3,5 L1,5 Z
                              M4,2 L6,2 L6,5 L4,5 L4,4 L5,4 L5,3 L4,3 Z
                              M3,5 L4,5 L4,6 L3,6 Z" /> <!--VE-->
                    
                    <Border
                        Grid.Row="1" Grid.Column="2"
                        Width="50" Height="50"
                        BorderBrush="{StaticResource Brush-Gray-700}"
                        BorderThickness="4"
                        CornerRadius="5"
                        HorizontalAlignment="Left"
                        RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <RotateTransform Angle="45"/>
                        </Border.RenderTransform>
                    </Border> <!--VE-->
                    <TextBlock
                        Grid.Row="1" Grid.Column="2"
                        Text="!"
                        FontFamily="{StaticResource JetBrainsMono}"
                        Foreground="{StaticResource Brush-Gray-700}"
                        FontSize="40"
                        FontWeight="Bold"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="13,0,0,0"
                        ></TextBlock> <!--VE-->
                    
                    <Border
                        Grid.Row="1" Grid.Column="2" 
                        Width="260" Height="70"
                        HorizontalAlignment="Right"
                        Background="{StaticResource Brush-Gray-700}">
                        
                        <TextBlock 
                            Text="{Binding WarningMessages, FallbackValue=Testing...}"
                            Style="{StaticResource WarningBody}"/> <!--Warning Body-->
                        
                    </Border> <!--Warning Body-->
                    
                </Grid> <!--Warning-->
            </Grid>
            
        </Grid>
    </Border>
    
</UserControl>
