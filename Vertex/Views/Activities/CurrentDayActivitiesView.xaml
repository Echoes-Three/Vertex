<UserControl x:Class="Vertex.Views.Activities.CurrentDayActivitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:activities="clr-namespace:Vertex.ViewModels.Activities"
             mc:Ignorable="d"
             d:DesignHeight="150" d:DesignWidth="700"
             d:DataContext="{d:DesignInstance Type=activities:ActivityItemViewModel}">
    
    <Grid Background="{StaticResource ElementBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/> <!--Activity Color-->
            <ColumnDefinition Width="2*"/> <!--Spacer-->
            <ColumnDefinition Width="77*"/> <!--Activity Content-->
            <ColumnDefinition Width="2*"/> <!--Spacer-->
            <ColumnDefinition Width="4*"/> <!--Delete Button-->
            <ColumnDefinition Width="2*"/> <!--Spacer-->
            <ColumnDefinition Width="4*"/> <!--Edit Button-->
            <ColumnDefinition Width="2*"/> <!--Spacer-->
            <ColumnDefinition Width="8*"/> <!--Done Button-->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/> <!--ActionButtons -->
            <RowDefinition Height="10"/> <!--Spacer-->
            <RowDefinition Height="Auto"/> <!--ActivityContent-->
            <RowDefinition Height="25"/> <!--Spacer-->
        </Grid.RowDefinitions>
        
        <Border 
            Grid.Row="0" 
            Grid.Column="2" 
            Background="{StaticResource ButtonBackgroundBrush}"/> <!--Title Background-->
        
        <Border 
            Grid.Row="2" 
            Grid.Column="0" Grid.ColumnSpan="9" 
            Background="{StaticResource ButtonBackgroundBrush}"/> <!--Content Background-->
        
        <Border 
            Grid.Row="0"
            Grid.Column="0" 
            Background="{Binding ActivityColor}"/> <!-- Activity Color-->
        
        <TextBlock
            Grid.Column="2"
            Grid.Row="0"
            Style="{StaticResource ActivityTitle}"
            Text="{Binding EntryData.Title}"/> <!--Ativity Title-->
        
        <TextBlock 
            Grid.Column="0"
            Grid.ColumnSpan="7"
            Grid.Row="2"
            Style="{StaticResource ActivityContent}"
            Text="{Binding EntryData.Content}"/> <!--Ativity Content-->
        
        <Button 
            Grid.Column="4"
            Grid.Row="0"
            Style="{StaticResource EditActivityButton}"
            Command="{Binding OnDeleteActivity}">
            <Path Style="{StaticResource BinIcon}"/>
        </Button> <!--Delete Button-->
        
        <Button 
            Grid.Column="6"
            Grid.Row="0"
            Style="{StaticResource EditActivityButton}"
            Command="{Binding OnEditActivity}">
            <Path Style="{StaticResource EditIcon}"/>
        </Button> <!--Edit Button-->
        
        <Button 
            Grid.Column="8"
            Grid.Row="0"
            Style="{StaticResource MarkActivityAsDoneButton}"
            Content="Done">
        </Button> <!--Done Button-->
            
        </Grid>
</UserControl>
