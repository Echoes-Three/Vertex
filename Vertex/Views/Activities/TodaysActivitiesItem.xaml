<UserControl x:Class="Vertex.Views.Activities.TodaysActivitiesItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:activities="clr-namespace:Vertex.ViewModels.Activities"
             mc:Ignorable="d"
             d:DesignHeight="170" d:DesignWidth="476"
             d:DataContext="{d:DesignInstance Type=activities:ActivityItemViewModel}">
    
    <Border
        Background="{StaticResource UltraLightBackgroundBrush}"
        Margin="0,0,0,20">
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/> <!--Spacer-->
                <ColumnDefinition Width="96*"/> <!--Content-->
                <ColumnDefinition Width="2*"/> <!--Spacer-->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="13"/> <!--Spacer -->
                <RowDefinition Height="25"/> <!--Action Elements-->
                <RowDefinition Height="13"/> <!--Spacer -->
                <RowDefinition Height="25"/> <!--Title-->
                <RowDefinition Height="13"/> <!--Spacer -->
                <RowDefinition Height="Auto"/> <!--Content-->
            </Grid.RowDefinitions>
            
            <Border 
                Grid.Row="0" Grid.RowSpan="5" 
                Grid.Column="0" Grid.ColumnSpan="3" 
                Background="{StaticResource LightBackgroundBrush}"/> <!--Header Background-->
            
            <!--<Border Grid.Row="0" Grid.RowSpan="6" Grid.Column="0"  Background="White" Opacity="0.3"/>
                <Border Grid.Row="0" Grid.RowSpan="6" Grid.Column="2" Background="White" Opacity="0.3"/>-->
            <!--<Border Grid.Row="0"  Grid.Column="0" Grid.ColumnSpan="3" Background="Red" Opacity="0.3"/>
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="Blue" Opacity="0.3"/>
                <Border Grid.Row="4" Grid.Column="1" Background="LimeGreen" Opacity="0.3"/>
                <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Background="Yellow" Opacity="0.3"/>-->
            
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76*"/> <!--Activity Color-->
                    <ColumnDefinition Width="2*"/> <!--Spacer-->
                    <ColumnDefinition Width="6*"/> <!--Delete Button-->
                    <ColumnDefinition Width="2*"/> <!--Spacer-->
                    <ColumnDefinition Width="6*"/> <!--Edit Button-->
                    <ColumnDefinition Width="2*"/> <!--Spacer-->
                    <ColumnDefinition Width="6*"/> <!--Done Button-->
                </Grid.ColumnDefinitions>
                
                <Border 
                    Grid.Column="0"
                    Background="{Binding ActivityColor}"/> <!-- Activity Color-->
                
                <Button 
                    Grid.Column="2"
                    Style="{StaticResource DeleteActivityButton}"
                    Command="{Binding OnDeleteActivity}">
                    <Path Style="{StaticResource DeleteActivityIcon}"/>
                </Button> <!--Delete Button-->
            
                <Button 
                    Grid.Column="4"
                    Style="{StaticResource EditActivityButton}"
                    Command="{Binding OnEditActivity}">
                    <Path Style="{StaticResource EditActivityIcon}"/>
                </Button> <!--Edit Button-->
                
                <ToggleButton 
                    Grid.Column="6"
                    Style="{StaticResource MarkActivityAsDoneButton}"
                    IsChecked="{Binding IsDone, FallbackValue=False}">
                    <Path Style="{StaticResource ActivityCheckBoxIcon}"/>
                </ToggleButton> <!--Done Button-->
                
            </Grid>
            
            <TextBlock
                Grid.Column="1"
                Grid.Row="3" 
                Style="{StaticResource ActivityTitle}"
                Text="{Binding EntryData.Title, FallbackValue=No Title}"/> <!--Title-->
            
            <TextBlock 
                Grid.Row="5" Grid.Column="1"
                Style="{StaticResource ActivityContent}"
                Text="{Binding EntryData.Content, FallbackValue=No Content}"/> <!--Content-->
            
        </Grid>
        
    </Border>
</UserControl>
