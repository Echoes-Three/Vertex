<UserControl x:Class="Vertex.Views.DonutGraph.DonutGraphTabWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels1="clr-namespace:Vertex.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="500"
             d:DataContext="{d:DesignInstance Type=viewModels1:MainWindowViewModel}">
    
    <Grid Background="{StaticResource ElementBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/> <!--Spacer-->
            <RowDefinition Height="10*"/> <!--Tab-->
            <RowDefinition Height="2*"/> <!--Spacer-->
            <RowDefinition Height="84*"/> <!--Donut Graph Content-->
            <RowDefinition Height="2*"/> <!--Spacer-->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/> <!--Spacer-->
            <ColumnDefinition Width="98*"/> <!--Tab Title & Donut Graph Content-->
            <ColumnDefinition Width="1*"/> <!--Spacer-->
        </Grid.ColumnDefinitions>
        
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86*"/> <!--Tab Tittle-->
                <ColumnDefinition Width="7*"/> <!--Add Break Button-->
            </Grid.ColumnDefinitions>
            
            <TextBlock
                Grid.Column="0"
                Text="Donut Graph"
                Style="{StaticResource DonutGraphTabTitle}"/> <!--Tab Tittle-->
            
            <Button 
                Grid.Column="1"
                Style="{StaticResource AddActivityButton}">
                
                <Path Style="{StaticResource AddIcon}"/>
                
            </Button> <!--Add Break Button-->
            
        </Grid> <!--Tab Buttons-->
        
    </Grid>
</UserControl>
