<UserControl x:Class="Vertex.Views.DonutGraph.DonutGraphTabWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels1="clr-namespace:Vertex.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="821" d:DesignWidth="1040"
             d:DataContext="{d:DesignInstance Type=viewModels1:MainWindowViewModel}">
    
    <Grid Background="{StaticResource ElementBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/> <!--Spacer-->
            <RowDefinition Height="4*"/> <!--Tab-->
            <RowDefinition Height="2*"/> <!--Spacer-->
            <RowDefinition Height="90*"/> <!--Donut Graph Content-->
            <RowDefinition Height="2*"/> <!--Spacer-->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/> <!--Spacer-->
            <ColumnDefinition Width="98*"/> <!--Tab Title & Donut Graph Content-->
            <ColumnDefinition Width="1*"/> <!--Spacer-->
        </Grid.ColumnDefinitions>
        
        <!--<Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3" Background="GreenYellow"></Border>-->
        
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86*"/> <!--Tab Tittle-->
                <ColumnDefinition Width="7*"/> <!--Add Break Button-->
            </Grid.ColumnDefinitions>
            
           
            <TextBlock
                Grid.Column="0"
                Text="Donut Graph"
                Style="{StaticResource DonutGraphTabTitle}"/> <!--Tab Tittle-->
            
            <Button 
                Grid.Column="1"
                Style="{StaticResource AddActivityButton}">
                
                <Path Style="{StaticResource AddIcon}"/>
                
            </Button> <!--Add Break Button-->
            
        </Grid> <!--Tab Buttons-->
        
        
        <Border Grid.Row="3" Grid.Column="1" Background="Transparent"></Border>
        <Canvas
            x:Name="DonutCanvas"
            Grid.Row="3" Grid.Column="1" 
            Width="1020" Height="740"
            Background="Transparent"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            MouseMove="OnMouseMove"
            MouseLeftButtonUp="OnMouseUp">
            

            <Border 
                BorderBrush="LightSlateGray" 
                Opacity="0.1"
                BorderThickness="60"
                Canvas.Left="235" Canvas.Top="95"
                Height="550" Width="550"
                CornerRadius="550"/>
            
            <Border 
                BorderBrush="LightSlateGray" 
                BorderThickness="4"
                Opacity="0.2"
                Canvas.Left="170" Canvas.Top="30"
                Height="680" Width="680"
                CornerRadius="680"/>
            
            <ItemsControl ItemsSource="{Binding DonutGraphVM.Slices}"
                          Canvas.Left="510" Canvas.Top="360"
                          Width="0" Height="0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Path Stroke="{Binding SliceColor}" StrokeThickness="60"
                              Data="{Binding PathData}"
                              MouseLeftButtonDown="OnMouseLeftButtonDown"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            
        </Canvas>
        
    </Grid>
</UserControl>
