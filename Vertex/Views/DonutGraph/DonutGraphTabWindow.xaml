<UserControl x:Class="Vertex.Views.DonutGraph.DonutGraphTabWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels1="clr-namespace:Vertex.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="700"
             d:DataContext="{d:DesignInstance Type=viewModels1:MainWindowViewModel}">
    
    <Grid>
        <Canvas
            x:Name="DonutCanvas"
            Width="700" Height="700"
            Background="Transparent"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
            
            
            <Ellipse 
                Height="700" Width="700"
                Fill="{StaticResource Brush-Gray-800}"/> <!--Donut Background-->
            
            <Grid
                Background="Transparent"
                Canvas.Top="225" Canvas.Left="225" 
                Height="250" Width="250">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15*"/> <!--Corner-->
                    <ColumnDefinition Width="70*"/> <!--Content-->
                    <ColumnDefinition Width="15*"/> <!--Corner-->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="15*"/> <!--Corner-->
                    <RowDefinition Height="15*"/> <!--Spacer-->
                    <RowDefinition Height="40*"/> <!--Content-->
                    <RowDefinition Height="15*"/> <!--Spacer-->
                    <RowDefinition Height="15*"/> <!--Corner-->
                </Grid.RowDefinitions>
                
                <Border 
                    Grid.Column="0" Grid.Row="0"
                    Background="{Binding DonutGraphVM.ActivityColor, FallbackValue=white}">
                    <TextBlock 
                        Text="✗"
                        FontFamily="{StaticResource JetBrainsMono}"
                        Foreground="{StaticResource Brush-Gray-700}"
                        FontSize="40"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"/>
                </Border> <!--VE / Activity Color Indicator-->
                <Border 
                    Grid.Column="2" Grid.Row="4"
                    Background="{Binding DonutGraphVM.ActivityColor, FallbackValue=white}">
                    <TextBlock 
                        Text="✗"
                        FontFamily="{StaticResource JetBrainsMono}"
                        Foreground="{StaticResource Brush-Gray-700}"
                        FontSize="40"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"/>
                </Border> <!--VE / Activity Color Indicator-->

                <TextBlock 
                    Grid.Column="0" Grid.Row="4"
                    Text="+"
                    FontFamily="{StaticResource JetBrainsMono}"
                    Foreground="{StaticResource Brush-Gray-200}"
                    FontWeight="Thin"
                    FontSize="50"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"/> <!--VE-->
                <TextBlock 
                    Grid.Column="2" Grid.Row="0"
                    Text="+"
                    FontFamily="{StaticResource JetBrainsMono}"
                    Foreground="{StaticResource Brush-Gray-200}"
                    FontWeight="Thin"
                    FontSize="50"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"/> <!--VE-->
                
                <Grid 
                    Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20*"/> <!--Day Of Week-->
                        <RowDefinition Height="60*"/> <!--Time-->
                        <RowDefinition Height="20*"/> <!--Date-->
                    </Grid.RowDefinitions>
                    
                    <!--<Border Grid.Row="0"  Background="Chartreuse" Opacity="0.5"/>
                    <Border Grid.Row="1"  Background="DodgerBlue" Opacity="0.5"/>
                    <Border Grid.Row="2"  Background="OrangeRed" Opacity="0.5"/>-->
                    
                    <TextBlock 
                        Grid.Row="1"
                        Text="{Binding DonutGraphVM.ClockTime, FallbackValue=12:50 AM}"
                        Style="{StaticResource ClockHour}"/> <!--Hour-->
                    
                    <TextBlock
                        Grid.Row="0"
                        Text="{Binding DonutGraphVM.ClockDayOfTheWeek, FallbackValue=WEDNESDAY}"
                        Style="{StaticResource ClockDayOfTheWeek}"/> <!--Day Of The Week-->
                
                    <TextBlock
                        Grid.Row="2"
                        Text="{Binding DonutGraphVM.ClockDate, FallbackValue=2026-12-31}"
                        Style="{StaticResource ClockDate}"/> <!--Date-->
                </Grid>
                
                
            </Grid> <!--Current Time-->
            
            <Border 
                Canvas.Left="75" Canvas.Top="75"
                Height="550" Width="550"
                CornerRadius="550"
                BorderBrush="{StaticResource Brush-Gray-700}" 
                BorderThickness="60"/> <!--Slice Track-->
            
            <TextBlock
                Canvas.Left="315" Canvas.Top="46" 
                Width="75" Height="28"
                Text="12 PM"
                Style="{StaticResource MainClockFace}"/> <!--12pm-->
            <TextBlock
                Canvas.Left="548" Canvas.Top="133" 
                Width="20" Height="28"
                Text="3"
                Style="{StaticResource MainClockFace}"/> <!--3pm-->
            <TextBlock
                Canvas.Left="630" Canvas.Top="333" 
                Width="20" Height="28"
                Text="6"
                Style="{StaticResource MainClockFace}"/> <!--6pm-->
            <TextBlock
                Canvas.Left="548" Canvas.Top="541" 
                Width="20" Height="28"
                Text="9"
                Style="{StaticResource MainClockFace}"/> <!--9pm-->
            <TextBlock
                Canvas.Left="315" Canvas.Top="628" 
                Width="75" Height="28"
                Text="12 AM"
                Style="{StaticResource MainClockFace}"/> <!--12am-->
            <TextBlock
                Canvas.Left="138" Canvas.Top="541" 
                Width="20" Height="28"
                Text="3"
                Style="{StaticResource MainClockFace}"/> <!--3am-->
            <TextBlock
                Canvas.Left="55" Canvas.Top="333" 
                Width="20" Height="28"
                Text="6"
                Style="{StaticResource MainClockFace}"/> <!--6am-->
            <TextBlock
                Canvas.Left="138" Canvas.Top="133" 
                Width="20" Height="28"
                Text="9"
                Style="{StaticResource MainClockFace}"/> <!--9am-->
            
            <ItemsControl 
                ItemsSource="{Binding DonutGraphVM.Slices}"
                Canvas.Left="350" Canvas.Top="350"
                Width="0" Height="0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Path
                            Stroke="{Binding SliceColor}" StrokeThickness="60"
                            Cursor="Hand"
                            Data="{Binding PathData}"
                            MouseRightButtonDown="OnMouseRightButtonDown"
                            MouseEnter="EnterSlice"
                            MouseLeave="LeaveSlice"
                            FocusVisualStyle="{x:Null}"
                            Tag="{Binding Data.Id}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl> <!--Slices-->
            
            <Path
                Canvas.Left="350" Canvas.Top="350"
                Stroke="{StaticResource Brush-Gray-700}" StrokeThickness="20"
                Data="{Binding DonutGraphVM.PathData}"
                FocusVisualStyle="{x:Null}"/> <!--Passed Time Slice-->
            
            <Line 
                X1="{Binding DonutGraphVM.X1}" 
                Y1="{Binding DonutGraphVM.Y1}" 
                X2="{Binding DonutGraphVM.X2}" 
                Y2="{Binding DonutGraphVM.Y2}"
                StrokeThickness="6"
                Stroke="{StaticResource LipstickRedBrush}"/> <!--Clock Hand-->
            
            </Canvas>
    </Grid>
</UserControl>
