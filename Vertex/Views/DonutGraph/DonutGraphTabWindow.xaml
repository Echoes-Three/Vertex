<UserControl x:Class="Vertex.Views.DonutGraph.DonutGraphTabWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels1="clr-namespace:Vertex.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1040"
             d:DataContext="{d:DesignInstance Type=viewModels1:MainWindowViewModel}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="6*"/> <!--Tab-->
            <RowDefinition Height="92*"/> <!--Donut Graph Content-->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/> <!--Spacer-->
            <ColumnDefinition Width="98*"/> <!--Tab Title & Donut Graph Content-->
            <ColumnDefinition Width="1*"/> <!--Spacer-->
        </Grid.ColumnDefinitions>
        
        <Border 
            Grid.Row="1" 
            Grid.Column="0" 
            Grid.ColumnSpan="3" 
            Background="{StaticResource ElectricAquaBrush}"/> <!--Donut Graph Background-->
        
        <TextBlock
            Grid.Column="1"
            Grid.Row="0" 
            Text="DONUT GRAPH"
            Foreground="{StaticResource LightTextBrush}"
            Style="{StaticResource DonutGraphTabTitle}"/> <!--Title-->
        
        <Canvas
            x:Name="DonutCanvas"
            Grid.Row="1" Grid.Column="1" 
            Width="1020" Height="754"
            Background="Transparent"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            MouseMove="OnMouseMove"
            MouseLeftButtonUp="OnMouseUp">
            
            <!--<TextBlock
                Text="+&#x2003;&#x2003;&#x2003;&#x2003;&#x2003;&#x2003;&#x2003;&#x2003;&#x2003;&#x2003;&#x2003;&#x2003;&#x2003;&#x2003;&#x2003;+&#x2003;&#x2003;&#x2003;&#x2003;&#x2003;&#x2003; &#x0A;"
                FontFamily="{StaticResource JetBrainsMono}"
                FontSize="60"
                FontWeight="Thin"
                Foreground="{StaticResource LightTextBrush}"
                LineHeight="680"
                TextAlignment="Left"></TextBlock> ~1~Visual Elements@1@-->
            <TextBlock
                Canvas.Left="920"
                Canvas.Top="680"
                Text="BERGEN&#x0A;KRISTIANSAND&#x0A;DRAMMEN&#x0A;STAVANGER&#x0A;"
                FontFamily="{StaticResource JetBrainsMono}"
                FontSize="8"
                FontWeight="Regular"
                Foreground="{StaticResource LightTextBrush}"
                LineHeight="10"
                TextAlignment="Left"></TextBlock> <!--Visual Elements-->
            <TextBlock
                Canvas.Left="870"
                Canvas.Top="655"
                Text="⚇"
                FontFamily="{StaticResource JetBrainsMono}"
                FontSize="70"
                FontWeight="Thin"
                Foreground="{StaticResource LightTextBrush}"
                LineHeight="15"
                TextAlignment="Left"></TextBlock> <!--Visual Elements-->
            <TextBlock
                Canvas.Left="0"
                Canvas.Top="50"
                Opacity="0.1"
                Width="1000"
                Text="EARTH"
                FontFamily="{StaticResource JetBrainsMono}"
                FontSize="500"
                FontWeight="ExtraBold"
                Foreground="{StaticResource LightTextBrush}"
                LineHeight="15"
                TextAlignment="Left"></TextBlock> <!--Visual Elements-->
            <TextBlock
                Canvas.Left="10"
                Canvas.Top="620"
                Text="01&#x0A;21&#x0A;18"
                FontFamily="{StaticResource JetBrainsMono}"
                FontSize="15"
                FontWeight="Regular"
                Foreground="{StaticResource LightTextBrush}"
                LineHeight="15"
                TextAlignment="Left"></TextBlock> <!--Visual Elements-->
            <TextBlock
                Canvas.Left="945"
                Canvas.Top="100"
                Text="15&#x0A;18&#x0A;01"
                FontFamily="{StaticResource JetBrainsMono}"
                FontSize="15"
                FontWeight="Regular"
                Foreground="{StaticResource LightTextBrush}"
                LineHeight="15"
                TextAlignment="Left"></TextBlock> <!--Visual Elements-->
            <Border
                Width="40"
                Height="40"
                Canvas.Top="15"
                Canvas.Right="45">
                <TextBlock
                    FontFamily="{StaticResource JetBrainsMono}"
                    FontSize="45"
                    FontWeight="thin"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Text="+"
                    Foreground="{StaticResource LightTextBrush}">
                </TextBlock>
            </Border> <!--Visual Element-->
            
            <Ellipse 
                Height="700" Width="700"
                Canvas.Left="160" Canvas.Top="27"
                Fill="{StaticResource ExtraDarkBackgroundBrush}"/> <!--Donut Background-->
            
            <Grid
                Background="Transparent"
                Canvas.Top="252" Canvas.Left="385" 
                Height="250" Width="250">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15*"/> <!--Corner-->
                    <ColumnDefinition Width="70*"/> <!--Content-->
                    <ColumnDefinition Width="15*"/> <!--Corner-->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="15*"/> <!--Corner-->
                    <RowDefinition Height="15*"/> <!--Spacer-->
                    <RowDefinition Height="40*"/> <!--Content-->
                    <RowDefinition Height="15*"/> <!--Spacer-->
                    <RowDefinition Height="15*"/> <!--Corner-->
                </Grid.RowDefinitions>
                
                <!--<Border Grid.Column="0" Grid.Row="0"  Background="Red" Opacity="0.5"/>
                <Border Grid.Column="0" Grid.Row="4"  Background="Red" Opacity="0.5"/>
                <Border Grid.Column="2" Grid.Row="0"  Background="Red" Opacity="0.5"/>
                <Border Grid.Column="2" Grid.Row="4"  Background="Red" Opacity="0.5"/>
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="White" Opacity="0.5"/>-->
                
                <Border 
                    Grid.Column="0" Grid.Row="0"
                    Background="{Binding DonutGraphVM.ActivityColor, FallbackValue=white}">
                    <TextBlock 
                        Text="✗"
                        FontFamily="{StaticResource JetBrainsMono}"
                        Foreground="{StaticResource DarkBackgroundBrush}"
                        FontSize="40"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"></TextBlock>
                </Border> <!--VE / Activity Color Indicated-->
                <Border 
                    Grid.Column="2" Grid.Row="4"
                    Background="{Binding DonutGraphVM.ActivityColor, FallbackValue=white}">
                    <TextBlock 
                        Style="{StaticResource DeleteActivityIcon}"
                        Text="✗"
                        Foreground="{StaticResource DarkBackgroundBrush}"
                        FontSize="40"
                    />
                </Border> <!--VE / Activity Color Indicated-->

                <TextBlock 
                    Grid.Column="0" Grid.Row="4"
                    Style="{StaticResource DeleteActivityIcon}"
                    Text="+"
                    FontWeight="Thin"
                    FontSize="50"
                />
                <TextBlock 
                    Grid.Column="2" Grid.Row="0"
                    Style="{StaticResource DeleteActivityIcon}"
                    Text="+"
                    FontSize="50"
                    FontWeight="Thin"
                />
                <Grid 
                    Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20*"/> <!--Day Of Week-->
                        <RowDefinition Height="60*"/> <!--Time-->
                        <RowDefinition Height="20*"/> <!--Date-->
                    </Grid.RowDefinitions>
                    
                    <!--<Border Grid.Row="0"  Background="Chartreuse" Opacity="0.5"/>
                    <Border Grid.Row="1"  Background="DodgerBlue" Opacity="0.5"/>
                    <Border Grid.Row="2"  Background="OrangeRed" Opacity="0.5"/>-->
                    
                    <TextBlock 
                        Grid.Row="1"
                        Text="{Binding DonutGraphVM.ClockTime, FallbackValue=12:50 AM}"
                        Style="{StaticResource ClockHour}"/> <!--Hour-->
                    
                    <TextBlock
                        Grid.Row="0"
                        Text="{Binding DonutGraphVM.ClockDayOfTheWeek, FallbackValue=WEDNESDAY}"
                        Style="{StaticResource ClockDayOfTheWeek}"/> <!--Day Of The Week-->
                
                    <TextBlock
                        Grid.Row="2"
                        Text="{Binding DonutGraphVM.ClockDate, FallbackValue=2026-12-31}"
                        Style="{StaticResource ClockDate}"/> <!--Date-->
                </Grid>
                
                
            </Grid> <!--Current Time-->
            
            <Border 
                BorderBrush="{StaticResource DarkBackgroundBrush}" 
                BorderThickness="60"
                Canvas.Left="235" Canvas.Top="102"
                Height="550" Width="550"
                CornerRadius="550"/> <!--Slices Track-->
            
            <TextBlock
                Canvas.Left="475" Canvas.Top="73" 
                Width="75" Height="28"
                Text="12 PM"
                Style="{StaticResource MainClockFace}"/> <!--12pm-->
            <TextBlock
                Canvas.Left="708" Canvas.Top="160" 
                Width="20" Height="28"
                Text="3"
                Style="{StaticResource MainClockFace}"/> <!--3pm-->
            <TextBlock
                Canvas.Left="790" Canvas.Top="360" 
                Width="20" Height="28"
                Text="6"
                Style="{StaticResource MainClockFace}"/> <!--6pm-->
            <TextBlock
                Canvas.Left="708" Canvas.Top="568" 
                Width="20" Height="28"
                Text="9"
                Style="{StaticResource MainClockFace}"/> <!--9pm-->
            <TextBlock
                Canvas.Left="475" Canvas.Top="655" 
                Width="75" Height="28"
                Text="12 AM"
                Style="{StaticResource MainClockFace}"/> <!--12am-->
            <TextBlock
                Canvas.Left="298" Canvas.Top="568" 
                Width="20" Height="28"
                Text="3"
                Style="{StaticResource MainClockFace}"/> <!--3am-->
            <TextBlock
                Canvas.Left="215" Canvas.Top="360" 
                Width="20" Height="28"
                Text="6"
                Style="{StaticResource MainClockFace}"/> <!--6am-->
            <TextBlock
                Canvas.Left="298" Canvas.Top="160" 
                Width="20" Height="28"
                Text="9"
                Style="{StaticResource MainClockFace}"/> <!--9am-->
            
            <ItemsControl 
                ItemsSource="{Binding DonutGraphVM.Slices}"
                Canvas.Left="510" Canvas.Top="377"
                Width="0" Height="0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Path
                            Stroke="{Binding SliceColor}" StrokeThickness="60"
                            Cursor="Hand"
                            Data="{Binding PathData}"
                            MouseLeftButtonDown="OnMouseLeftButtonDown"
                            MouseEnter="EnterSlice"
                            MouseLeave="LeaveSlice"
                            FocusVisualStyle="{x:Null}"
                            Tag="{Binding EntryData.Id}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl> <!--Slices-->
            
            <ItemsControl 
                ItemsSource="{Binding DonutGraphVM.Orbiters}"
                Canvas.Left="510" Canvas.Top="377"
                Width="0" Height="0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Canvas>
                            <Border
                                Canvas.Left="{Binding CanvasLeft}"
                                Canvas.Top="{Binding CanvasTop}"
                                Tag="{Binding EntryData.Id}"
                                ToolTipService.InitialShowDelay="0">
                                <TextBlock 
                                    Style="{StaticResource OrbiterIcon}" 
                                    Text="◈"/>
                                <Border.ToolTip>
                                    <ToolTip 
                                            Background="Transparent" 
                                            Placement="Top"
                                            BorderBrush="Transparent">
                                            <Grid Width="220"> 
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="10*"/>
                                                    <RowDefinition Height="80*"/>
                                                    <RowDefinition Height="10*"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="10*"/>
                                                    <ColumnDefinition Width="80*"/>
                                                    <ColumnDefinition Width="10*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <Border 
                                                    Grid.Column="0" Grid.ColumnSpan="3"
                                                    Grid.Row="0" Grid.RowSpan="3"
                                                    Background="{StaticResource DarkBackgroundBrush}"/> <!--Reminder Content Background-->
                                                
                                                <Border
                                                    Height="20"
                                                    Width="20"
                                                    Grid.Column="0"
                                                    Grid.Row="0">
                                                    <TextBlock Style="{StaticResource ActivityHoverToolTip}"/>
                                                </Border> <!--Visual Element-->
                                                <Border
                                                    Height="20"
                                                    Width="20"
                                                    Grid.Column="2"
                                                    Grid.Row="0" >
                                                    <TextBlock Style="{StaticResource ActivityHoverToolTip}"/>
                                                </Border> <!--Visual Element-->
                                                <Border
                                                    Height="20"
                                                    Width="20"
                                                    Grid.Column="0"
                                                    Grid.Row="2">
                                                    <TextBlock Style="{StaticResource ActivityHoverToolTip}"/>
                                                </Border> <!--Visual Element-->
                                                <Border
                                                    Height="20"
                                                    Width="20"
                                                    Grid.Column="2"
                                                    Grid.Row="2">
                                                    <TextBlock Style="{StaticResource ActivityHoverToolTip}"/>
                                                </Border> <!--Visual Element-->
                                                
                                                <TextBlock 
                                                    Grid.Column="1"
                                                    Grid.Row="0"
                                                    Text="{Binding ReminderSetForHour}"
                                                    Style="{StaticResource OrbitersTooltipHeader}"/>
                                                
                                                <TextBlock 
                                                    Grid.Column="1"
                                                    Grid.Row="1"
                                                    Text="{Binding ReminderContent}"
                                                    Style="{StaticResource OrbitersTooltipContent}"/>
                                                
                                            </Grid>
                                        </ToolTip>
                                </Border.ToolTip>
                            </Border>
                            
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl> <!--Orbiters-->
            
            <Path
                Canvas.Left="510" Canvas.Top="377"
                Stroke="{StaticResource DarkBackgroundBrush}" StrokeThickness="20"
                Data="{Binding DonutGraphVM.PathData}"
                MouseLeftButtonDown="OnMouseLeftButtonDown"
                FocusVisualStyle="{x:Null}"/> <!--Passed Time Slice-->
            <Line X1="{Binding DonutGraphVM.X1}" 
                              Y1="{Binding DonutGraphVM.Y1}" 
                              X2="{Binding DonutGraphVM.X2}" 
                              Y2="{Binding DonutGraphVM.Y2}"
                              StrokeThickness="6"
                              Stroke="{StaticResource LipstickRedBrush}"/> <!--Clock Hand-->
            
            <ToggleButton
                x:Name="Snap"
                Width="40"
                Height="40"
                Canvas.Top="15"
                Canvas.Left="0"
                IsChecked="{Binding DonutGraphVM.Snap}">
                <ToggleButton.Style>
                    <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BasicToggleButton}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource LightTextBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
                <TextBlock
                    FontFamily="{StaticResource JetBrainsMono}"
                    FontSize="40"
                    FontWeight="Regular"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Text" Value="↑"/>
                                <Setter Property="Foreground" Value="{StaticResource LightTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=Snap}" Value="True">
                                        <Setter Property="Text" Value="↓"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=Snap}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource LightTextBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource ElectricAquaBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
            </ToggleButton> <!--Snapping Toggle-->
            
            </Canvas>
    </Grid>
</UserControl>
