<Window x:Class="Vertex.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Vertex.ViewModels"
        xmlns:consistency="clr-namespace:Vertex.Views"
        xmlns:reminders="clr-namespace:Vertex.Views.Reminders"
        xmlns:activities="clr-namespace:Vertex.Views.Activities"
        xmlns:donutGraph="clr-namespace:Vertex.Views.DonutGraph"
        mc:Ignorable="d"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        AllowsTransparency="True"
        Title="MainWindow"
        d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">
    
    <Viewbox Stretch="Uniform">
        
        <Grid Width="1600" Height="900" 
            Background="{DynamicResource WindowBackgroundBrush}">
               <Grid.RowDefinitions>
                   <RowDefinition Height="5*"/> <!--TitleBar-->
                   <RowDefinition Height="95*"/> <!--Main Body-->
               </Grid.RowDefinitions>
            
            <consistency:TitleBarView Grid.Row="0"/><!--TitleBar-->
            
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/> <!--Spacer-->
                    <ColumnDefinition Width="65*"/> <!--Donut Graph-->
                    <ColumnDefinition Width="1*"/> <!--Spacer-->
                    <ColumnDefinition Width="32*"/> <!--Side Panel-->
                    <ColumnDefinition Width="1*"/> <!--Spacer-->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/> <!--Spacer-->
                    <RowDefinition Height="96*"/> <!--Donut Graph & Side Panel-->
                    <RowDefinition Height="2*"/> <!--Spacer-->
                </Grid.RowDefinitions>
                
                <donutGraph:DonutGraphTabWindow Grid.Row="1" Grid.Column="1" /><!--Donut Graph-->
                
                <Grid  Grid.Row="1" Grid.Column ="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46*"/> <!--Activities-->
                        <RowDefinition Height="2*"/> <!--Spacer-->
                        <RowDefinition Height="28*"/> <!--Reminders-->
                        <RowDefinition Height="2*"/> <!--Spacer-->
                        <RowDefinition Height="22*"/> <!--Consistency-->
                    </Grid.RowDefinitions>
                    
                    <activities:ActivitiesTabView Grid.Row="0"/><!--Activities-->
                    <reminders:RemindersTabView Grid.Row="2"/><!--Reminders-->
                    <consistency:ConsistencyView Grid.Row="4"/><!--Consistency-->
                    
                </Grid> <!--Side Panel Activities/Reminders/Consistency-->
            </Grid>
        </Grid><!--Main Body-->
    </Viewbox>
</Window>
