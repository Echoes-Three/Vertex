<Window x:Class="Vertex.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:consistency="clr-namespace:Vertex.Views"
        xmlns:viewModels="clr-namespace:Vertex.ViewModels"
        xmlns:reminders="clr-namespace:Vertex.Views.Reminders"
        xmlns:activities="clr-namespace:Vertex.Views.Activities"
        mc:Ignorable="d"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        AllowsTransparency="True"
        Title="MainWindow"
        d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">
    
    <Viewbox Stretch="Uniform">
        
        <Grid Width="1440" Height="900" 
            Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/> <!--TitleBar-->
            <RowDefinition Height="95*"/> <!--Main Body-->
        </Grid.RowDefinitions>
            
            <consistency:TitleBarView Grid.Row="0"/><!--TitleBar-->
            
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/> <!--Side Bar-->
                <ColumnDefinition Width="97*"/> <!--Main Body-->
            </Grid.ColumnDefinitions>
            
            <Border Background="{DynamicResource ElementBackgroundBrush}"/> <!--Side Bar-->
            
            <Grid  Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.7*"/> <!--Spacer-->
                    <RowDefinition Height="62.5*"/> <!--Donut Graph & Reminders-->
                    <RowDefinition Height="1.7*"/> <!--Spacer-->
                    <RowDefinition Height="32.4*"/> <!--Activities & Consistency-->
                    <RowDefinition Height="1.7*"/> <!--Spacer-->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/> <!--Spacer-->
                    <ColumnDefinition Width="95*"/> <!--Activities, Consistency, Donut Graph, Reminders-->
                    <ColumnDefinition Width="1*"/> <!--Spacer-->
                </Grid.ColumnDefinitions>
                
                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40*"/> <!--Donut Graph-->
                        <ColumnDefinition Width="1*"/> <!--Spacer-->
                        <ColumnDefinition Width="59*"/><!--Activities-->
                    </Grid.ColumnDefinitions>
                    
                    <!--Donut Graph-->
                    <activities:ActivitiesTabView Grid.Column="2"/><!--Activities-->
                </Grid><!--Donut Graph & Reminders-->
                
                <Grid Grid.Row="3" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="49.5*"/> <!--Reminders--> 
                        <ColumnDefinition Width="1*"/> <!--Spacer-->
                        <ColumnDefinition Width="49.5*"/> <!--Consistency-->
                    </Grid.ColumnDefinitions>
                    
                    <reminders:RemindersTabView Grid.Column="0"/><!--Reminders-->
                    <consistency:ConsistencyView Grid.Column="2"/><!--Consistency-->
                </Grid>
            </Grid>
        </Grid><!--Main Body-->
    </Grid>
    </Viewbox>
</Window>
