                    </Grid.ColumnDefinitions>
                    
                    <!--<Border  Grid.Column="0" Opacity="0.3" Background="Aqua"></Border>-->
                    
                    <activities:ActivitiesTab 
                        Grid.Column="1"
                        Visibility="{Binding IsChecked, ElementName=ActivityToggle, Converter={StaticResource BoolToVis}}"/><!--Activities-->
                    
                    <reminders:RemindersTab
                        Grid.Column="1"
                        Visibility="{Binding IsChecked, ElementName=ReminderToggle, Converter={StaticResource BoolToVis}}"/><!--Reminders-->
                        
                    <form:FormsTab
                        Grid.Column="1"
                        Visibility="{Binding IsChecked, ElementName=FormToggle, Converter={StaticResource BoolToVis}}"/><!--Form-->
                    
                </Grid> <!--Side Tab-->
                
            </Grid>
            
        </Grid> <!--Main Body-->
        
    </Viewbox>       
</Window>
