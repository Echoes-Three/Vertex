<Window x:Class="Vertex.Views.MainWindow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Vertex.ViewModels"
        xmlns:reminders="clr-namespace:Vertex.Views.Reminders"
        xmlns:activities="clr-namespace:Vertex.Views.Activities"
        xmlns:donutGraph="clr-namespace:Vertex.Views.DonutGraph"
        xmlns:mainWindow="clr-namespace:Vertex.Views.MainWindow"
        mc:Ignorable="d"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Title="MainWindow"
        Icon="/Assets/Icon/VertexIcon.ico"
        d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">
    
    <Viewbox Stretch="Uniform">
        
        <Grid Width="1600" Height="900"  
              Background="{DynamicResource Brush-Gray-800}">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/> <!--TitleBar-->
                <RowDefinition Height="840"/> <!--Main Body-->
                <RowDefinition Height="20"/> <!--Spacer-->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/> <!--Spacer-->
                <ColumnDefinition Width="1560"/> <!--Main Body-->
                <ColumnDefinition Width="20"/> <!--Spacer-->
            </Grid.ColumnDefinitions>
            
            <mainWindow:TitleBarView Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" /><!--TitleBar-->
            
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/> <!--Donut Graph-->
                    <ColumnDefinition Style="{StaticResource SideTab}"/> <!--Side Tab-->
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" Background="{StaticResource VividRoyalBrush}"/> <!--Donut Background-->
                
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100"/> <!--Spacer-->
                        <RowDefinition Height="155"/> <!--Toggles-->
                        <RowDefinition Height="585"/> <!--Spacer-->
                    </Grid.RowDefinitions>
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/> <!--Spacer-->
                        <ColumnDefinition Width="45"/> <!--Toggles-->
                        <ColumnDefinition Width="10"/> <!--Spacer-->
                    </Grid.ColumnDefinitions>
                    
                    <Grid Grid.Row="1" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45"/> <!--Activity Tab Toggle-->
                            <RowDefinition Height="10"/> <!--Spacer-->
                            <RowDefinition Height="45"/> <!--Reminder Tab Toggle-->
                            <RowDefinition Height="10"/> <!--Spacer-->
                            <RowDefinition Height="45"/> <!--Add Tab Toggle-->
                        </Grid.RowDefinitions>
                        
                        
                        <Border  Grid.Row="0" Style="{StaticResource ActivityToggleBackground}"/> <!--Activity Toggle Background-->

                        <ToggleButton 
                            x:Name="ActivityToggle"
                            Grid.Row="0"
                            Content="⍹"
                            Style="{StaticResource RightSideToggleButton}"/> <!--Activity Tab Toggle-->
                        
                        
                        <Border Grid.Row="2" Style="{StaticResource ReminderToggleBackground}"/> <!--Reminder Toggle Background-->

                        <ToggleButton 
                            x:Name="ReminderToggle"
                            Grid.Row="2"
                            Content="⍶"
                            Style="{StaticResource RightSideToggleButton}"/> <!--Reminder Tab Toggle-->
                            
                        
                        <Border Grid.Row="4" Style="{StaticResource AddToggleBackground}"/>  <!--Add Toggle Background-->

                        <ToggleButton 
                            x:Name="AddToggle"
                            Grid.Row="4"
                            Content="+"
                            Style="{StaticResource RightSideToggleButton}"/> <!--Add Tab Toggle-->
                        
                    </Grid> <!--Toggles-->
                    
                </Grid> <!--Right Side Toggles-->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="66*"/> <!--Activities-->
                        <RowDefinition Height="1*"/> <!--Spacer-->
                        <RowDefinition Height="33*"/> <!--Reminders-->
                    </Grid.RowDefinitions>
                    
                    <!--<activities:ActivitiesTab Grid.Row="0"/>~1~Activities@1@
                    <reminders:RemindersTab Grid.Row="2"/>~1~Reminders@1@-->
                    <!--<donutGraph:DonutGraphTabWindow Grid.Row="1" Grid.Column="1" />~1~Donut Graph@1@-->
                    
                </Grid> <!--Side Panel Activities/Reminders/Consistency-->
                
            </Grid>
            
        </Grid> <!--Main Body-->
        
    </Viewbox>       
</Window>
