<UserControl x:Class="Vertex.Views.MainWindow.TitleBarView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Vertex.ViewModels"
        mc:Ignorable="d"
        d:DesignHeight="40"
        d:DesignWidth="1600"
        d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1440"/> <!--Draggable Area-->
            <ColumnDefinition Width="60"/> <!--Minimize Button-->
            <ColumnDefinition Width="20"/> <!--Spacer-->
            <ColumnDefinition Width="60"/> <!--Close Button-->
            <ColumnDefinition Width="20"/> <!--Spacer-->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/> <!--Spacer-->
            <RowDefinition Height="20"/> <!--Buttons-->
            <RowDefinition Height="10"/> <!--Spacer-->
        </Grid.RowDefinitions>
        
        <Border
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Grid.Row="0"
            Grid.RowSpan="3"
            Background="Transparent"
            MouseLeftButtonDown="TitleBarDrag"/> <!--Draggable Area-->
            
        <Button 
            Grid.Column="1"
            Grid.Row="1"
            Click="MinimizeButton"
            Style="{StaticResource MinimizeButton}">
            <TextBlock 
                Style="{StaticResource MinimizeWindowIcon}"
                Text="–"/>
        </Button> <!-- Minimize Button-->
        
        <Button 
            Grid.Column="3"
            Grid.Row="1"
            Click="CloseButton"
            Style="{StaticResource CloseButton}">
            <TextBlock 
                Style="{StaticResource CloseWindowIcon}"
                Text="✗"/>
        </Button><!--Close Button-->
        
    </Grid>
</UserControl>