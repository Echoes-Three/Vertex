<UserControl x:Class="Vertex.Views.MainWindow.TitleBarView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Vertex.ViewModels"
        mc:Ignorable="d"
        d:DesignHeight="20"
        d:DesignWidth="700"
        d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">
    
    <Grid>
        <Grid.ColumnDefinitions>
        <ColumnDefinition Width="10*"/> <!--Logo/App Name-->
        <ColumnDefinition Width="80*"/> <!--Draggable Area-->
        <ColumnDefinition Width="10*"/> <!--Tittle Bar Buttons-->
    </Grid.ColumnDefinitions>
        
        <Border
            Grid.Column="1"
            Grid.Row="0"
            Background="Transparent"
            MouseLeftButtonDown="TitleBarDrag"/> <!--Draggable Area-->
        
        <TextBlock 
            Grid.Column="0"
            Text="VERTEX"
            Style="{StaticResource ApplicationName}"></TextBlock>
        

        <Grid Grid.Column="2" Grid.Row="0"> <!--Tittle Bar Buttons-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*"/> <!--Spacer-->
                <ColumnDefinition Width="35*"/> <!-- Minimize Button-->
                <ColumnDefinition Width="10*"/> <!--Spacer-->
                <ColumnDefinition Width="35*"/> <!--Close Button-->
                <ColumnDefinition Width="10*"/> <!--Spacer-->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30*"/> <!--Spacer-->
                <RowDefinition Height="40*"/> <!--Buttons-->
                <RowDefinition Height="30*"/> <!--Spacer-->
            </Grid.RowDefinitions>
            
            <Button 
                Grid.Column="1"
                Grid.Row="1"
                Click="MinimizeButton"
                Style="{StaticResource MinimizeButton}">
                <TextBlock 
                    Style="{StaticResource MinimizeWindowIcon}"
                    Text="–"/>
            </Button> <!-- Minimize Button-->
            
            <Button 
                Grid.Column="3"
                Grid.Row="1"
                Click="CloseButton"
                Style="{StaticResource CloseButton}">
                <TextBlock 
                    Style="{StaticResource CloseWindowIcon}"
                    Text="✗"/>
            </Button><!--Close Button-->
        </Grid>
    </Grid>
</UserControl>