<UserControl x:Class="Vertex.Views.Reminders.ReminderNotDoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:reminders="clr-namespace:Vertex.ViewModels.Reminders"
             mc:Ignorable="d"
             d:DesignHeight="250" d:DesignWidth="650"
             d:DataContext="{d:DesignInstance Type=reminders:ReminderItemViewModel}">
    
    <Grid Background="{StaticResource ElementBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!--Reminder Content-->
            <RowDefinition Height="10"/> <!--Spacer-->
            <RowDefinition Height="30"/> <!--Buttons-->
            <RowDefinition Height="30"/> <!--Spacer-->
        </Grid.RowDefinitions>

        <Rectangle Grid.Row="0" Fill="{StaticResource ButtonBackgroundBrush}"/> <!--Content Background-->
        
        <TextBlock 
            Grid.Row="0"
            Style="{StaticResource ReminderContent}"
            Text="{Binding Data.Content}"/> <!--Reminder Content-->
        
        
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/> <!--Delete Button-->
                <ColumnDefinition Width="2*"/> <!--Spacer-->
                <ColumnDefinition Width="46*"/> <!--Reminder Date Info-->
                <ColumnDefinition Width="30*"/> <!--Spacer-->
                <ColumnDefinition Width="5*"/> <!--Edit Button-->
                <ColumnDefinition Width="2*"/> <!--Spacer-->
                <ColumnDefinition Width="10*"/> <!--Done Button-->
            </Grid.ColumnDefinitions>
            
            <Button 
                Grid.Column="0"
                Style="{StaticResource DeleteReminderButton}"
                Command="{Binding OnDeleteReminder}">
                <Path Style="{StaticResource BinIcon}"/>
            </Button> <!--Delete Button-->
            
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45*"/> <!--Reminder Create At-->
                    <ColumnDefinition Width="5*"/> <!--Spacer-->
                    <ColumnDefinition Width="45*"/> <!--Reminder Done At-->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50*"/> <!--Created At Label / Done At Label-->
                    <RowDefinition Height="50*"/> <!--Created At Date / Done At Date-->
                </Grid.RowDefinitions>
                
                <TextBlock
                    Grid.Column="0"
                    Grid.Row="0"
                    Text="Created at:"
                    Style="{StaticResource ReminderDateLabel}"/><!--Created At Label-->
                
                <TextBlock
                    Grid.Column="0"
                    Grid.Row="1"
                    Text="{Binding CreatedAt}"
                    Style="{StaticResource ReminderDateLabel}"/> <!--Created At Date-->
                
                <TextBlock
                    Grid.Column="2"
                    Grid.Row="0"
                    Text="Set for:"
                    Style="{StaticResource ReminderDateLabel}"/> <!--Done At Label-->
                
                <TextBlock
                    Grid.Column="2"
                    Grid.Row="1"
                    Text="{Binding SetFor}"
                    Style="{StaticResource ReminderDateLabel}"/> <!--Done At Date-->
                
            </Grid>
            
            <Button 
                Grid.Column="4"
                Style="{StaticResource EditReminderButton}">
                <Path Style="{StaticResource EditIcon}"/>
            </Button> <!--Edit Button-->
            
            <Button 
                Grid.Column="6"
                Style="{StaticResource MarkReminderAsDoneButton}"
                Content="Done"
                Command="{Binding OnReminderDone}">
            </Button> <!--Done Button-->
            
        </Grid>
    </Grid>
</UserControl>
