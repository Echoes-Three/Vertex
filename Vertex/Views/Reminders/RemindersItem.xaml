<UserControl x:Class="Vertex.Views.Reminders.RemindersItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:remindersViewModel="clr-namespace:Vertex.ViewModels.Reminders"
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="476"
             d:DataContext="{d:DesignInstance Type=remindersViewModel:ReminderItemViewModel}">
    <Border
        Margin="0,0,0,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="80*"/> <!--Content-->
                <RowDefinition Height="10*"/> <!--Set For / Buttons-->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/> <!--Spacer-->
                <ColumnDefinition Width="96*"/> <!--Content-->
                <ColumnDefinition Width="2*"/> <!--Spacer-->
            </Grid.ColumnDefinitions>
            
            <!--<Border 
                Grid.Column="0" 
                Grid.Row="0"
                Grid.ColumnSpan="3"
                Grid.RowSpan="3"
                CornerRadius="0,5,5,0"
                Background="{StaticResource DarkBackgroundBrush}"/> ~1~Reminder Background@1@-->
            
            <TextBlock 
                Grid.Row="0"
                Grid.Column="1" 
                Style="{StaticResource ReminderContent}"
                Text="{Binding EntryData.Content, FallbackValue=No Content}"/> <!--Reminder Content-->
            
            <Grid Grid.Row="1" Grid.Column="1" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44*"/> <!--Reminder Date Info-->
                    <ColumnDefinition Width="34*"/> <!--Spacer-->
                    <ColumnDefinition Width="6*"/> <!--Delete Button-->
                    <ColumnDefinition Width="2*"/> <!--Spacer-->
                    <ColumnDefinition Width="6*"/> <!--Edit Button-->
                </Grid.ColumnDefinitions>
                
                
                <Border 
                    Grid.Column="0" 
                    Grid.Row="0"  
                    Background="{StaticResource ChartreuseBrush}"/> <!--Set For Date Background Highlight-->
                
                <TextBlock
                    Grid.Column="0"
                    Text="{Binding SetFor, FallbackValue=In 5 Day(s)}"
                    Style="{StaticResource ReminderSetForLabel}"/> <!--Set For Date-->
                
                <Button 
                    Grid.Column="2"
                    Style="{StaticResource DeleteReminderButton}"
                    Command="{Binding OnDeleteReminder}">
                    <TextBlock 
                        Style="{StaticResource DeleteReminderIcon}"
                        Text="✗"/>
                </Button> <!--Delete Button-->
                
                <Button 
                    Grid.Column="4"
                    Style="{StaticResource EditReminderButton}"
                    Command="{Binding OnEditReminder}">
                    <TextBlock 
                        Style="{StaticResource EditReminderIcon}"
                        Text="⎋"/>
                </Button> <!--Edit Button-->
                
            </Grid>
        </Grid>
    </Border>
</UserControl>
