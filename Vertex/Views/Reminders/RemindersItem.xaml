<UserControl x:Class="Vertex.Views.Reminders.RemindersItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:remindersViewModel="clr-namespace:Vertex.ViewModels.Reminders"
             mc:Ignorable="d"
             d:DesignHeight="333" d:DesignWidth="476"
             d:DataContext="{d:DesignInstance Type=remindersViewModel:ReminderItemViewModel}">
    <Border
        Background="{StaticResource UltraLightBackgroundBrush}"
        Margin="0,0,0,20">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!--Content-->
                <RowDefinition Height="25"/> <!--Set For / Buttons-->
                <RowDefinition Height="13"/> <!--Spacer-->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/> <!--Spacer-->
                <ColumnDefinition Width="96*"/> <!--Content-->
                <ColumnDefinition Width="2*"/> <!--Spacer-->
            </Grid.ColumnDefinitions>
            
            <TextBlock 
                Grid.Row="0"
                Grid.Column="1" 
                Style="{StaticResource ReminderContent}"
                Text="{Binding EntryData.Content, FallbackValue=No Content}"/> <!--Reminder Content-->
            
            <Grid Grid.Row="1" Grid.Column="1" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64*"/> <!--Reminder Date Info-->
                    <ColumnDefinition Width="14*"/> <!--Spacer-->
                    <ColumnDefinition Width="6*"/> <!--Delete Button-->
                    <ColumnDefinition Width="2*"/> <!--Spacer-->
                    <ColumnDefinition Width="6*"/> <!--Edit Button-->
                    <ColumnDefinition Width="2*"/> <!--Spacer-->
                    <ColumnDefinition Width="6*"/> <!--Done Button-->
                </Grid.ColumnDefinitions>
                
                <Border 
                    Grid.Column="0" 
                    Grid.Row="0"  
                    Background="{StaticResource ChartreuseBrush}"/> <!--Set For Date Background Highlight-->
                
                <TextBlock
                    Grid.Column="0"
                    Text="{Binding SetFor, FallbackValue=yyyy-MM-dd / hh:mm tt}"
                    Style="{StaticResource ReminderSetForLabel}"/> <!--Set For Date-->
                
                <Button 
                    Grid.Column="2"
                    Style="{StaticResource DeleteReminderButton}"
                    Command="{Binding OnDeleteReminder}">
                    <Path Style="{StaticResource DeleteReminderIcon}"/>
                </Button> <!--Delete Button-->
                
                <Button 
                    Grid.Column="4"
                    Style="{StaticResource EditReminderButton}"
                    Command="{Binding OnEditReminder}">
                    <Path Style="{StaticResource EditReminderIcon}"/>
                </Button> <!--Edit Button-->
                
                <ToggleButton 
                    Grid.Column="6"
                    Style="{StaticResource MarkReminderAsDoneButton}"
                    IsChecked="{Binding IsDone, FallbackValue=False}">
                    <Path Style="{StaticResource ReminderCheckBoxIcon}"/>
                </ToggleButton> <!--Done Button-->
                
            </Grid>
        </Grid>
    </Border>
    
</UserControl>
