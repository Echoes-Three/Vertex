<UserControl x:Class="Vertex.Views.Reminders.RemindersTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:remindersView="clr-namespace:Vertex.Views.Reminders"
             xmlns:remindersViewModel="clr-namespace:Vertex.ViewModels.Reminders"
             DataContext="{Binding RemindersVM}"
             mc:Ignorable="d"
             d:DesignHeight="840" d:DesignWidth="400"
             d:DataContext="{d:DesignInstance Type=remindersViewModel:RemindersViewModel}">
    
    <Grid Background="{StaticResource Brush-Gray-800}">
        <Grid.RowDefinitions>
            <RowDefinition Height="15"/> <!--Spacer-->
            <RowDefinition Height="25"/> <!--Title-->
            <RowDefinition Height="40"/> <!--Spacer-->
            <RowDefinition Height="760"/> <!--Reminders-->
        </Grid.RowDefinitions>
    
        <TextBlock
            Grid.Row="1"
            Text="REMINDERS"
            Style="{StaticResource ReminderTabTitle}"/> <!--Tab Tittle-->
        
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="360"/> <!--VE-->
                <RowDefinition Height="84"/> <!--VE-->
                <RowDefinition Height="316"/> <!--VE-->
            </Grid.RowDefinitions>
           
            <TextBlock 
                Grid.Row="0"
                Grid.RowSpan="2"
                Text="⍶"
                FontFamily="{StaticResource JetBrainsMono}"
                FontSize="450"
                FontWeight="Regular"
                VerticalAlignment="Bottom"
                Margin="0,0,20,30"
                HorizontalAlignment="Center"
                Opacity="0.01"
                Foreground="{StaticResource Brush-Gray-100}"/> <!--Upper Text Element-->
            
            <TextBlock 
                Grid.Row="1"
                Text="POSTEA"
                FontFamily="{StaticResource JetBrainsMono}"
                FontSize="70"
                FontWeight="Bold"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Opacity="0.01"
                Foreground="{StaticResource Brush-Gray-100}"/> <!--Middle Text Element-->
            
            
            <TextBlock 
                Grid.Row="2"
                Text="14 09 10 09 13 21 18 01&#x0a;15 11 21 25 01 19 21"
                FontFamily="{StaticResource JetBrainsMono}"
                FontSize="10"
                FontWeight="bold"
                VerticalAlignment="Bottom" HorizontalAlignment="Left"
                Opacity="0.05"
                Foreground="{StaticResource Brush-Gray-100}"/> <!--Bottom Left Visual Element-->
            
            <TextBlock 
               Grid.Row="2"
               Text="10 10 02 01"
               FontFamily="{StaticResource JetBrainsMono}"
               FontSize="10"
               FontWeight="bold"
               VerticalAlignment="Bottom" HorizontalAlignment="Right"
               Opacity="0.05"
               Foreground="{StaticResource Brush-Gray-100}"/> <!--Bottom Right Visual Element-->
           
        </Grid> <!--VE-->
        
        <ScrollViewer 
            Grid.Row="3"
            VerticalScrollBarVisibility="Auto">
            
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}">
                    <Setter Property="Width" Value="0"/>
                    <Setter Property="MinWidth" Value="0"/>
                </Style>
            </ScrollViewer.Resources>
            
            <ItemsControl ItemsSource="{Binding Reminders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <remindersView:RemindersItem/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
        </ScrollViewer> <!--Reminders-->
        
    </Grid>
</UserControl>
