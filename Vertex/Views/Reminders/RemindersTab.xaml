<UserControl x:Class="Vertex.Views.Reminders.RemindersTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:remindersView="clr-namespace:Vertex.Views.Reminders"
             xmlns:remindersViewModel="clr-namespace:Vertex.ViewModels.Reminders"
             DataContext="{Binding RemindersVM}"
             mc:Ignorable="d"
             d:DesignHeight="276" d:DesignWidth="504"
             d:DataContext="{d:DesignInstance Type=remindersViewModel:RemindersViewModel}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/> <!--Spacer-->
            <RowDefinition Height="16*"/> <!--Tab-->
            <RowDefinition Height="2*"/> <!--Spacer-->
            <RowDefinition Height="78*"/> <!--Reminders Content-->
            <RowDefinition Height="2*"/> <!--Spacer-->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/> <!--Spacer-->
            <ColumnDefinition Width="96*"/> <!--Tab Title & Reminders Content-->
            <ColumnDefinition Width="2*"/> <!--Spacer-->
        </Grid.ColumnDefinitions>
    
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76*"/> <!--Tab Tittle-->
                <ColumnDefinition Width="1*"/> <!--Spacer-->
                <ColumnDefinition Width="8*"/> <!--Add Reminder Button-->
            </Grid.ColumnDefinitions>
            
            <TextBlock
                Grid.Column="0"
                Text="REMINDERS"
                Foreground="{StaticResource LightTextBrush}"
                Style="{StaticResource ReminderTabTitle}"/> <!--Tab Tittle-->
            
            <Button 
                Grid.Column="2"
                Style="{StaticResource AddReminderButton}"
                Command="{Binding OnAddNewReminder}">
                <TextBlock 
                    Style="{StaticResource AddReminderIcon}"
                    Text="+"/>
            </Button> <!--Add Reminder Button-->
            
            <!--<TextBlock 
                Grid.Column="0" 
                Text="❮❮❮❮"
                FontFamily="{StaticResource JetBrainsMono}"
                FontSize="100"
                FontWeight="bold"
                Margin="180,0,0,0"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                IsHitTestVisible="False"
                Foreground="{StaticResource LightTextBrush}"/> ~1~Visual Element@1@-->
            
        </Grid> <!--Tab Buttons-->
        
        <Grid
            Grid.Column="1" Grid.Row="3"
            Width="300" Height="150">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmpty}" Value="False">
                            <Setter Property="Visibility" Value="Hidden"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="15*"/> <!--Upper Text-->
                <RowDefinition Height="5*"/> <!--Spacer-->
                <RowDefinition Height="60*"/> <!--Visual Element-->
                <RowDefinition Height="5*"/> <!--Spacer-->
                <RowDefinition Height="15*"/> <!--Upper Text-->
            </Grid.RowDefinitions>
            <TextBlock 
                Grid.Row="0"
                Text="EMPTY EMPTY EMPTY"
                FontFamily="{StaticResource JetBrainsMono}"
                FontSize="20"
                FontWeight="ExtraBlack"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Foreground="{StaticResource DarkBackgroundBrush}"/> <!--Upper Text Element-->
            
            <Border 
                Grid.Row="2" 
                Margin="15,0"
                Background="{StaticResource DarkBackgroundBrush}"></Border> <!--Visual Element Background-->
            
            <TextBlock 
                Grid.Row="2"
                Text="❮❮❮❮"
                FontFamily="{StaticResource JetBrainsMono}"
                FontSize="150"
                FontWeight="bold"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Foreground="{StaticResource ExtraDarkBackgroundBrush}"/> <!--Visual Element-->
            <TextBlock 
                Grid.Row="2"
                Text="❮❮❮❮❮"
                FontFamily="{StaticResource JetBrainsMono}"
                FontSize="150"
                FontWeight="bold"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Foreground="{StaticResource ExtraDarkBackgroundBrush}"/> <!--Visual Element-->
            
            <TextBlock 
                Grid.Row="4"
                Text="EMPTY EMPTY EMPTY"
                FontFamily="{StaticResource JetBrainsMono}"
                FontSize="20"
                FontWeight="ExtraBlack"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Foreground="{StaticResource DarkBackgroundBrush}"/> <!--lower Text Element-->
            
        </Grid> <!--Empty Reminder Placeholder-->
        
        
        <ScrollViewer Grid.Row="3" Grid.Column="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ScrollBar}"/>
            </ScrollViewer.Resources>
            
            <ItemsControl ItemsSource="{Binding Reminders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <remindersView:RemindersItem/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
        </ScrollViewer> <!--Reminders-->
        
    </Grid>
</UserControl>
