<UserControl x:Class="Vertex.Views.Reminders.RemindersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Vertex.Views"
             xmlns:viewModels="clr-namespace:Vertex.ViewModels"
             xmlns:reminders="clr-namespace:Vertex.Views.Reminders"
             xmlns:reminders1="clr-namespace:Vertex.ViewModels.Reminders"
             DataContext="{Binding RemindersVM}"
             mc:Ignorable="d"
             d:DesignHeight="250" d:DesignWidth="500"
             d:DataContext="{d:DesignInstance Type=reminders1:RemindersViewModel}">
    
    <Grid Background="{DynamicResource ElementBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="4*"/> <!--Spacer-->
            <RowDefinition Height="20*"/> <!--Tab-->
            <RowDefinition Height="4*"/> <!--Spacer-->
            <RowDefinition Height="76*"/> <!--Reminders Content-->
            <RowDefinition Height="4*"/> <!--Spacer-->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/> <!--Spacer-->
            <ColumnDefinition Width="98*"/> <!--Tab Title & Reminders Content-->
            <ColumnDefinition Width="2*"/> <!--Spacer-->
        </Grid.ColumnDefinitions>
        
        
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76*"/> <!--Tab Tittle-->
                <ColumnDefinition Width="8*"/> <!--Add Reminder Button-->
                <ColumnDefinition Width="8*"/> <!--Reminders History Button-->
                <ColumnDefinition Width="8*"/> <!--Sort Button-->
            </Grid.ColumnDefinitions>
            
            <TextBlock
                Grid.Column="0"
                Text="Reminders"
                Style="{DynamicResource BasicTextBlock}"/> <!--Tab Tittle-->
            
            <Button Grid.Column="1"
                    Style="{DynamicResource AddReminderButton}"
                    Command="{Binding OnAddNewReminder}">
                <Path Style="{DynamicResource AddIcon}"/>
            </Button> <!--Add Reminder Button-->
            
            <Button Grid.Column="2"
                    Style="{DynamicResource HistoryButton}">
                <Path Style="{DynamicResource HistoryIcon}"/>
            </Button> <!--Reminders History Button-->
            
            <Button Grid.Column="3"
                    Command="{Binding OnSortIcon}"
                    Style="{DynamicResource SortButton}">
                <Path Style="{DynamicResource SortIcon}"
                      Tag="{Binding CurrentIcon}"/>
            </Button> <!--Sort Button-->
            
        </Grid> <!--Tab Buttons-->
        
        <ScrollViewer Grid.Row="3" Grid.Column="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ScrollBar}"/>
            </ScrollViewer.Resources>
            <ItemsControl ItemsSource="{Binding Reminders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <reminders:ReminderItemView/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
