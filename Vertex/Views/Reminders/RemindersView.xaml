<UserControl x:Class="Vertex.Views.RemindersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Vertex.Views"
             xmlns:viewModels="clr-namespace:Vertex.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="250" d:DesignWidth="500"
             d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">
    
    <Grid Background="{DynamicResource ElementBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="4*"/> <!--Spacer-->
            <RowDefinition Height="20*"/> <!--Tab Tittle-->
            <RowDefinition Height="4*"/> <!--Spacer-->
            <RowDefinition Height="76*"/> <!--Reminders Content-->
            <RowDefinition Height="4*"/> <!--Spacer-->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/> <!--Spacer-->
            <ColumnDefinition Width="98*"/> <!--Tab Title & Graph Content-->
            <ColumnDefinition Width="2*"/> <!--Spacer-->
        </Grid.ColumnDefinitions>
        
        <!--<Border Grid.Row="0" Grid.RowSpan="5" Grid.Column="0" Background="White"></Border>
        <Border Grid.Row="0" Grid.RowSpan="5" Grid.Column="2" Background="White"></Border>
        <Border Grid.Row="0" Grid.Column="1" Background="White"></Border>
        <Border Grid.Row="4" Grid.Column="1" Background="White"></Border>
        
        <Border Grid.Row="2" Grid.Column="1" Background="White"></Border>-->
        
        
        <TextBlock
            Grid.Row="1"
            Grid.Column="1"
            Text="Reminders"
            Style="{DynamicResource BasicTitle}"/> <!--Tab Tittle-->
        
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76*"/> <!--Tab Tittle-->
                <ColumnDefinition Width="8*"/> <!--Add Reminder Button-->
                <ColumnDefinition Width="8*"/> <!--Reminders History Button-->
                <ColumnDefinition Width="8*"/> <!--Sort Button-->
            </Grid.ColumnDefinitions>
            
            <!--<Border Grid.Row="0" Grid.Column="0" Background="White" Opacity="0.5"></Border>
            <Border Grid.Row="0" Grid.Column="1" Background="White" Opacity="0.4"></Border>
            <Border Grid.Row="0" Grid.Column="2" Background="White" Opacity="0.3"></Border>
            <Border Grid.Row="0" Grid.Column="3" Background="White" Opacity="0.2"></Border>-->
            
            <Button Grid.Column="1"
                    Style="{DynamicResource TabButton}"
                    Click="OnAddReminder">
                <Path Style="{DynamicResource AddIcon}"/>
            </Button>
            <Button Grid.Column="2"
                    Style="{DynamicResource TabButton}">
                <Path Style="{DynamicResource HistoryIcon}"/>
            </Button>
            <Button Grid.Column="3"
                    Command="{Binding RemindersVM.OnSortIcon}"
                    Style="{DynamicResource TabButton}">
                <Path Style="{DynamicResource SortIcon}"
                      Tag="{Binding RemindersVM.CurrentIcon}"
                      />
            </Button>
            
        </Grid> <!--Tab Buttons-->
        
        <ScrollViewer Grid.Row="3" Grid.Column="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ScrollBar}"/>
            </ScrollViewer.Resources>
            <ItemsControl ItemsSource="{Binding RemindersVM.Reminders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:ReminderItemView/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        
        
    </Grid>
</UserControl>
