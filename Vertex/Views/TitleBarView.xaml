<UserControl x:Class="Vertex.Views.TitleBarView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Vertex.Views"
        xmlns:viewModels="clr-namespace:Vertex.ViewModels"
        mc:Ignorable="d"
        d:DesignHeight="20"
        d:DesignWidth="700"
        d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">
    
    <Grid Background="{StaticResource ElementBackgroundBrush}">
        <Grid.ColumnDefinitions>
        <ColumnDefinition Width="10*"/> <!--Logo/App Name-->
        <ColumnDefinition Width="80*"/> <!--Draggable Area-->
        <ColumnDefinition Width="10*"/> <!--Tittle Bar Buttons-->
    </Grid.ColumnDefinitions>
        
        <Border
            Grid.Column="1"
            Grid.Row="0"
            Background="Transparent"
            MouseLeftButtonDown="TitleBarDrag"/> <!--Draggable Area-->
        

        <Grid Grid.Column="2" Grid.Row="0"> <!--Tittle Bar Buttons-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*"/> <!--Spacer-->
                <ColumnDefinition Width="35*"/> <!-- Minimize Button-->
                <ColumnDefinition Width="10*"/> <!--Spacer-->
                <ColumnDefinition Width="35*"/> <!--Close Button-->
                <ColumnDefinition Width="10*"/> <!--Spacer-->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="25*"/> <!--Spacer-->
                <RowDefinition Height="50*"/> <!--Buttons-->
                <RowDefinition Height="25*"/> <!--Spacer-->
            </Grid.RowDefinitions>
            
            <Button 
                Grid.Column="1"
                Grid.Row="1"
                Click="MinimizeButton"
                Style="{StaticResource MinimizeButton}"/><!-- Minimize Button-->
            <Button 
                Grid.Column="3"
                Grid.Row="1"
                Click="CloseButton"
                Style="{StaticResource CloseButton}"/><!--Close Button-->
        </Grid>
    </Grid>
</UserControl>